.btn {
    --bg: var(--panel3);
    --bgH: var(--line);
    --ink: var(--ink);
    --edge: rgba(0, 0, 0, .35);
    --ol: var(--navyDD);
    position: relative;
    display: flex;
    --sn-display: "inline-block";
    background-color: var(--bg);
    color: var(--ink);
    padding: 2px 6px 1px;
    --sn-line-height: "10px";
    --sn-text-shadow: "0 1px 0 rgba(0, 0, 0, .3)";
    --sn-box-shadow: "inset 0 1px 0 0 rgba(255, 255, 255, .35), inset 0 -2px 0 0 var(--edge), 0 -1px 0 0 var(--ol), 0 1px 0 0 var(--ol), -1px 0 0 0 var(--ol), 1px 0 0 0 var(--ol), 0 2px 0 0 var(--ol), 0 3px 0 0 rgba(0, 0, 0, .35)";
    --sn-bs-n: "8";
    --sn-bs-0: "inset 0 1 0 0";
    --sn-bsc-0: rgba(255, 255, 255, .35);
    --sn-bs-1: "inset 0 -2 0 0";
    --sn-bsc-1: var(--edge);
    --sn-bs-2: "0 -1 0 0";
    --sn-bsc-2: var(--ol);
    --sn-bs-3: "0 1 0 0";
    --sn-bsc-3: var(--ol);
    --sn-bs-4: "-1 0 0 0";
    --sn-bsc-4: var(--ol);
    --sn-bs-5: "1 0 0 0";
    --sn-bsc-5: var(--ol);
    --sn-bs-6: "0 2 0 0";
    --sn-bsc-6: var(--ol);
    --sn-bs-7: "0 3 0 0";
    --sn-bsc-7: rgba(0, 0, 0, .35);
    --sn-transition: "transform .06s";
}

.btn:hover:enabled {
    background-color: var(--bgH);
    --sn-transform: "translateY(-1px)";
}

.btn:active:enabled {
    --sn-transform: "translateY(1px)";
    --sn-box-shadow: "inset 0 1px 0 0 rgba(0, 0, 0, .2), 0 -1px 0 0 var(--ol), 0 1px 0 0 var(--ol), -1px 0 0 0 var(--ol), 1px 0 0 0 var(--ol)";
    --sn-bs-n: "5";
    --sn-bs-0: "inset 0 1 0 0";
    --sn-bsc-0: rgba(0, 0, 0, .2);
    --sn-bs-1: "0 -1 0 0";
    --sn-bsc-1: var(--ol);
    --sn-bs-2: "0 1 0 0";
    --sn-bsc-2: var(--ol);
    --sn-bs-3: "-1 0 0 0";
    --sn-bsc-3: var(--ol);
    --sn-bs-4: "1 0 0 0";
    --sn-bsc-4: var(--ol);
}

.btn.pressed {
    --sn-transform: "translateY(1px)";
    --sn-box-shadow: "inset 0 1px 0 0 rgba(0, 0, 0, .2), 0 -1px 0 0 var(--ol), 0 1px 0 0 var(--ol), -1px 0 0 0 var(--ol), 1px 0 0 0 var(--ol)";
    --sn-bs-n: "5";
    --sn-bs-0: "inset 0 1 0 0";
    --sn-bsc-0: rgba(0, 0, 0, .2);
    --sn-bs-1: "0 -1 0 0";
    --sn-bsc-1: var(--ol);
    --sn-bs-2: "0 1 0 0";
    --sn-bsc-2: var(--ol);
    --sn-bs-3: "-1 0 0 0";
    --sn-bsc-3: var(--ol);
    --sn-bs-4: "1 0 0 0";
    --sn-bsc-4: var(--ol);
}

.btn:disabled {
    --sn-cursor: "not-allowed";
    --sn-filter: "grayscale(.7) brightness(.75)";
    opacity: .6;
}

.btn-green {
    --bg: var(--green);
    --bgH: var(--greenL);
    --ink: var(--navyD);
    --sn-text-shadow: "none";
}

.btn-coral {
    --bg: var(--coral);
    --bgH: var(--coralL);
