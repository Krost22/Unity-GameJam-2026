}

#app.black #titlebar {
    background-color: #050208;
    --sn-box-shadow: "inset 0 -1px 0 0 var(--magenta)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--magenta);
}

#app.black .app-name {
    color: var(--magentaL);
}

#app.black #hud {
