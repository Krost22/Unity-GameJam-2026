    background-color: var(--panel);
    color: var(--ink);
    --sn-box-shadow: "0 -1px 0 0 var(--violetL), 0 1px 0 0 var(--violetL), -1px 0 0 0 var(--violetL), 1px 0 0 0 var(--violetL), 0 3px 0 0 rgba(0, 0, 0, .45)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--violetL);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--violetL);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--violetL);
    --sn-bs-4: "0 3 0 0";
    --sn-bsc-4: rgba(0, 0, 0, .45);
    --sn-animation: "winin .28s cubic-bezier(.2, 1.5, .4, 1)";
}

.win.closing {
