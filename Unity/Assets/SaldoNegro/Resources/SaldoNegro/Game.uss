}

.squash {
    --sn-animation: "squash .28s ease-out";
}

.wiggle {
    --sn-animation: "wiggle .5s ease-in-out infinite";
}

.pulse {
    --sn-animation: "pulse 1s steps(2) infinite";
}

.shake {
    --sn-animation: "shake .4s linear";
}

.bump {
    --sn-animation: "bump .45s ease-out";
}

.shrink {
    --sn-animation: "shrink .45s ease-out";
}

.t-kbd {
    display: flex;
    --sn-display: "inline-block";
    --sn-font: "inherit";
    height: 9px;
    --sn-line-height: "9px";
    padding: 0 2px;
    margin-left: 3px;
    color: var(--ink2);
    background-color: var(--navyD);
    --sn-box-shadow: "0 0 0 1px var(--line), 0 1px 0 1px var(--navyDD)";
    --sn-bs-n: "2";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--line);
    --sn-bs-1: "0 1 0 1";
    --sn-bsc-1: var(--navyDD);
    --sn-vertical-align: "top";
    letter-spacing: 0;
    --sn-white-space: "nowrap";
    --sn-text-transform: "uppercase";
    --sn-text-shadow: "none";
}

#os {
    background-color: var(--bg);
}

#os > .sn-before {
    --sn-content: "''";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    --sn-background: "radial-gradient(circle at 50% 120%, rgba(211, 63, 156, .45) 0%, rgba(107, 63, 196, .18) 40%, rgba(0, 0, 0, 0) 70%), repeating-linear-gradient(90deg, rgba(168, 128, 255, .07) 0 1px, transparent 1px 12px), repeating-linear-gradient(0deg, rgba(168, 128, 255, .07) 0 1px, transparent 1px 12px)";
}

#boot {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(7, 5, 18, .62);
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    --sn-line-height: "10px";
    flex-direction: row;
}

#boot .thanks {
    width: 268px;
    background-color: var(--panel);
    color: var(--ink);
    --sn-box-shadow: "0 -1px 0 0 var(--violetL), 0 1px 0 0 var(--violetL), -1px 0 0 0 var(--violetL), 1px 0 0 0 var(--violetL), 0 3px 0 0 rgba(0, 0, 0, .45)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--violetL);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--violetL);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--violetL);
    --sn-bs-4: "0 3 0 0";
    --sn-bsc-4: rgba(0, 0, 0, .45);
    --sn-animation: "winin .28s cubic-bezier(.2, 1.5, .4, 1) .35s both";
}

#boot .thanks {
    position: relative;
}

#boot .thanks.closing {
    --sn-animation: "winout .15s ease-in forwards";
}

#boot .jam-logo {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 41px;
    height: 44px;
    padding: 5px;
    background-color: var(--navyDD);
    --sn-box-shadow: "0 -1px 0 0 var(--violetL), 0 1px 0 0 var(--violetL), -1px 0 0 0 var(--violetL), 1px 0 0 0 var(--violetL), 0 2px 0 0 rgba(0, 0, 0, .45)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--violetL);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--violetL);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--violetL);
    --sn-bs-4: "0 2 0 0";
    --sn-bsc-4: rgba(0, 0, 0, .45);
}

#boot .jam-logo .t-svg {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
}

#boot .win-head {
    justify-content: center;
}

#boot .thanks-body {
    padding: 6px 8px 7px;
}

#boot .thanks-body .t-p {
    margin: 0 0 5px;
    color: var(--ink2);
}

#boot .thanks-body .hi {
    color: var(--cyan);
}

#boot .thanks-body .y {
    color: var(--yellow);
}

#boot .thanks-body .warn {
    color: var(--coralL);
}

#boot .thanks-foot {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    flex-direction: row;
}

#boot .thanks-foot .sign {
    color: var(--ink3);
}

#menu {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
}

#menu .logo {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-animation: "logo-in .6s cubic-bezier(.2, 1.6, .4, 1) both";
    --sn-text-transform: "uppercase";
}

#menu .logo .t-span {
    font-size: 32px;
    --sn-line-height: "32px";
    letter-spacing: 2px;
    padding-left: 6px;
}

#menu .logo .l1 {
    color: var(--yellow);
    --sn-text-shadow: "2px 0 0 var(--navyDD), -2px 0 0 var(--navyDD), 0 2px 0 var(--navyDD), 0 -2px 0 var(--navyDD), 0 4px 0 var(--magenta), 2px 4px 0 var(--magenta), -2px 4px 0 var(--magenta)";
}

#menu .logo .l2 {
    color: var(--cyan);
    margin-top: 2px;
    --sn-text-shadow: "0 4px 0 var(--violet)";
}

#menu .tagline {
    margin: 8px 0 12px;
    color: var(--ink2);
}

#menu .menu-buttons {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "7px";
    width: 124px;
}

#menu .menu-buttons .btn {
    width: 100%;
    --sn-text-align: "center";
    padding: 3px 0 2px;
}

#menu .menu-foot {
    position: absolute;
    bottom: 4px;
    right: 6px;
    margin: 0;
    color: var(--ink3);
}

#webshop {
    background-color: var(--creamL);
    color: var(--coal);
}

#webshop .shop-bar {
    height: 14px;
    background-color: var(--violet);
    display: flex;
    --sn-display: "flex";
    align-items: center;
    padding: 0 4px;
    --sn-gap: "4px";
    color: var(--creamL);
    flex-direction: row;
}

#webshop .shop-bar .url {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    height: 9px;
    background-color: var(--creamL);
    --sn-line-height: "9px";
    padding: 0 3px;
    color: var(--coalL);
    --sn-box-shadow: "0 0 0 1px var(--violetD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violetD);
}

#webshop .shop-logo {
    color: var(--yellow);
}

#webshop .shop-main {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    bottom: 0;
    display: flex;
    --sn-display: "flex";
    padding: 6px 8px;
    --sn-gap: "8px";
    flex-direction: row;
}

#webshop .prod-img {
    width: 130px;
    height: 120px;
    --sn-background: "radial-gradient(ellipse at 35% 40%, var(--violet) 0%, var(--violetD) 55%, var(--violetDD) 100%)";
    --sn-box-shadow: "0 0 0 1px var(--violetL)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violetL);
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

#webshop .prod-img .t-canvas {
    position: absolute;
    left: 0;
    top: 0;
}

#webshop .prod-img .tag {
    position: absolute;
    top: 4px;
    right: -6px;
    background-color: var(--coral);
    color: var(--creamL);
    padding: 1px 3px;
    --sn-animation: "wiggle .7s infinite";
}

#webshop .prod-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "2px";
}

#webshop .p-title {
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--coal);
    --sn-text-shadow: "1px 0 0 currentColor";
}

#webshop .p-ed {
    color: var(--orangeD);
}

#webshop .p-inc {
    color: var(--cyanD);
    margin-bottom: 2px;
}

#webshop .t-ul {
    --sn-list-style: "none";
    margin: 0 0 2px;
    padding: 0;
}

#webshop .t-li {
    color: var(--coalL);
    padding-left: 8px;
    position: relative;
    opacity: 0;
    --sn-transform: "translateX(-6px)";
    --sn-transition: "opacity .2s, transform .25s cubic-bezier(.2, 1.6, .4, 1)";
}

#webshop .t-li > .sn-before {
    --sn-content: "'★'";
    position: absolute;
    left: 0;
    color: var(--yellowD);
}

#webshop .t-li.show {
    opacity: 1;
    --sn-transform: "none";
}

#webshop .p-price {
    display: flex;
    --sn-display: "flex";
    --sn-align-items: "baseline";
    --sn-gap: "6px";
    flex-direction: row;
}

#webshop .p-price .t-b {
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--greenD);
    --sn-font-weight: "normal";
}

#webshop .p-price s {
    color: var(--creamDD);
}

#webshop .p-bal {
    color: var(--coalL);
}

#webshop .p-bal .t-i {
    color: var(--coral);
    --sn-font-style: "normal";
}

#webshop .buy-now {
    margin-top: 4px;
    align-self: flex-start;
    padding: 4px 8px 3px;
}

#webshop .thanks {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background-color: rgba(248, 244, 255, .92);
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--greenD);
}

#app {
    background-color: var(--bg);
}

#titlebar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 11px;
    background-color: var(--navyDD);
    color: var(--ink2);
    display: flex;
    --sn-display: "flex";
    align-items: center;
    padding: 0 2px 0 3px;
    --sn-gap: "3px";
    --sn-box-shadow: "inset 0 -1px 0 0 var(--violetD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--violetD);
    flex-direction: row;
}

.app-icon {
    width: 8px;
    height: 8px;
    --sn-background-size: "8px 8px";
    --sn-image-rendering: "pixelated";
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

.app-name {
    color: var(--yellow);
    letter-spacing: 1px;
    --sn-text-transform: "uppercase";
}

#clock {
    margin-left: auto;
    margin-right: 6px;
    color: var(--ink2);
}

#clock .pip {
    display: flex;
    --sn-display: "inline-block";
    width: 4px;
    height: 4px;
    margin-left: 2px;
    background-color: var(--panel3);
    --sn-vertical-align: "1px";
}

#clock .pip.on {
    background-color: var(--yellow);
}

#clock .pip.now {
    background-color: var(--magentaL);
    --sn-animation: "pulse 1s steps(2) infinite";
}

.tb-btn {
    height: 9px;
    --sn-line-height: "9px";
    padding: 0 3px;
    background-color: var(--panel2);
    color: var(--ink);
    display: flex;
    --sn-display: "flex";
    align-items: center;
    flex-direction: row;
}

.tb-btn:hover {
    background-color: var(--violet);
}

.tb-btn.off {
    color: var(--ink3);
    --sn-text-decoration: "line-through";
}

.tb-btn .t-kbd {
    margin-left: 3px;
    height: 7px;
    --sn-line-height: "7px";
    padding: 0 1px;
    background-color: var(--navyDD);
    color: var(--ink3);
    --sn-box-shadow: "none";
    --sn-bs-n: "0";
}

#hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 27px;
    background-color: var(--navyD);
    display: flex;
    --sn-display: "flex";
    --sn-gap: "3px";
    padding: 2px 3px;
    flex-direction: row;
}

.hud-box {
    position: relative;
    background-color: var(--panel);
    color: var(--ink);
    --sn-box-shadow: "0 -1px 0 0 var(--line), 0 1px 0 0 var(--line), -1px 0 0 0 var(--line), 1px 0 0 0 var(--line), inset 0 1px 0 0 rgba(168, 128, 255, .18)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--line);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--line);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--line);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--line);
    --sn-bs-4: "inset 0 1 0 0";
    --sn-bsc-4: rgba(168, 128, 255, .18);
}

#hud-capital {
    width: 112px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "4px";
    padding: 0 4px;
    --sn-box-shadow: "0 -1px 0 0 var(--yellowD), 0 1px 0 0 var(--yellowD), -1px 0 0 0 var(--yellowD), 1px 0 0 0 var(--yellowD), inset 0 1px 0 0 rgba(255, 211, 78, .15)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--yellowD);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--yellowD);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--yellowD);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--yellowD);
    --sn-bs-4: "inset 0 1 0 0";
    --sn-bsc-4: rgba(255, 211, 78, .15);
    flex-direction: row;
}

#hud-capital .coin {
    width: 8px;
    height: 8px;
    --sn-background-size: "8px 8px";
    --sn-image-rendering: "pixelated";
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

#capital {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    transform-origin: left 50%;
    --sn-white-space: "nowrap";
}

#capital.small {
    font-size: 8px;
    --sn-line-height: "10px";
}

#hud-goal {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    padding: 2px 4px 0;
}

.goal-top {
    display: flex;
    --sn-display: "flex";
    justify-content: space-between;
    --sn-gap: "6px";
    --sn-line-height: "9px";
    height: 9px;
    flex-direction: row;
}

#goal-title {
    color: var(--coralL);
}

#goal-text {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    --sn-white-space: "nowrap";
    color: var(--ink);
}

#hud-goal .bar {
    margin-top: 2px;
    height: 8px;
    background-color: var(--navyDD);
    position: relative;
    --sn-box-shadow: "0 0 0 1px var(--line)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--line);
}

#hud-goal .bar .t-i {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--green);
    --sn-box-shadow: "inset 0 2px 0 0 var(--greenL), inset 0 -1px 0 0 var(--greenD)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 2 0 0";
    --sn-bsc-0: var(--greenL);
    --sn-bs-1: "inset 0 -1 0 0";
    --sn-bsc-1: var(--greenD);
    --sn-transition: "width .5s cubic-bezier(.2, 1.4, .4, 1)";
}

#hud-goal .bar .t-i.debt {
    background-color: var(--yellow);
    --sn-box-shadow: "inset 0 2px 0 0 var(--yellowL), inset 0 -1px 0 0 var(--yellowD)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 2 0 0";
    --sn-bsc-0: var(--yellowL);
    --sn-bs-1: "inset 0 -1 0 0";
    --sn-bsc-1: var(--yellowD);
}

#btn-pay {
    position: absolute;
    top: 2px;
    right: 3px;
    bottom: 3px;
    left: 3px;
    --sn-text-align: "center";
    --sn-line-height: "16px";
    padding: 0;
    --sn-z-index: "2";
}

#hud-days {
    width: 92px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    --sn-gap: "2px";
    flex-direction: row;
}

#hud-days .t-i {
    width: 10px;
    height: 15px;
    --sn-line-height: "15px";
    --sn-text-align: "center";
    --sn-font-style: "normal";
    background-color: var(--panel3);
    color: var(--ink2);
}

#hud-days .t-i.past {
    background-color: var(--navyD);
    color: var(--ink3);
    --sn-text-decoration: "line-through";
}

#hud-days .t-i.last {
    color: var(--coral);
    --sn-box-shadow: "inset 0 -2px 0 0 var(--coral)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -2 0 0";
    --sn-bsc-0: var(--coral);
}

#hud-days .t-i.now {
    background-color: var(--yellow);
    color: var(--navyD);
    --sn-animation: "pulse 1s steps(2) infinite";
}

#hud-days .t-i.now.last {
    background-color: var(--coral);
    color: var(--creamL);
}

#hud-days .free {
    color: var(--green);
}

#hud-days .free .t-b {
    --sn-font-weight: "normal";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--ink);
    margin-left: 3px;
    --sn-vertical-align: "-3px";
}

#body {
    position: absolute;
    left: 0;
    right: 0;
    top: 38px;
    bottom: 0;
}

#sidebar {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 80px;
    bottom: 3px;
}

#markets {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.mcard {
    position: relative;
    height: 25px;
    background-color: var(--panel);
    padding: 2px 2px 0 17px;
    --sn-cursor: "pointer";
    --sn-transition: "transform .1s";
}

.mcard .ico {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 12px;
    height: 12px;
}

.mcard .nm {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-line-height: "9px";
    --sn-white-space: "nowrap";
    overflow: hidden;
}

.mcard .hint {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-line-height: "10px";
    height: 10px;
}

.mcard .hint.up {
    color: var(--green);
}

.mcard .hint.down {
    color: var(--coral);
}

.mcard .hint.flat {
    color: var(--orange);
}

.mcard .t-canvas.spark {
    position: absolute;
    right: 2px;
    bottom: 3px;
    width: 28px;
    height: 10px;
}

.mcard.sel {
    --ol: var(--mk);
    background-color: var(--panel2);
    --sn-box-shadow: "0 -1px 0 0 var(--mk), 0 1px 0 0 var(--mk), -1px 0 0 0 var(--mk), 1px 0 0 0 var(--mk), inset 3px 0 0 0 var(--mk)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--mk);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--mk);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--mk);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--mk);
    --sn-bs-4: "inset 3 0 0 0";
    --sn-bsc-4: var(--mk);
}

.mcard.locked {
    background-color: var(--navyD);
    color: var(--ink3);
    --sn-cursor: "not-allowed";
}

.mcard.locked .ico {
    opacity: .4;
}

.mcard .lock {
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 8px;
    height: 10px;
}

.mcard .alert {
    position: absolute;
    right: -2px;
    top: -3px;
    background-color: var(--orange);
    color: var(--navyD);
    padding: 0 2px;
    --sn-line-height: "8px";
    height: 8px;
    --sn-box-shadow: "0 0 0 1px var(--navyDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--navyDD);
    --sn-animation: "pulse .9s steps(2) infinite";
}

.mcard .live {
    color: var(--orange);
    --sn-animation: "pulse .6s steps(2) infinite";
}

.mcard.unlocking {
    --sn-animation: "bump .6s ease-out 2";
}

#nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.nav-btn {
    position: relative;
    height: 15px;
    background-color: var(--panel);
    --sn-text-align: "left";
    padding: 3px 4px 0 16px;
    --sn-line-height: "10px";
    color: var(--ink);
}

.nav-btn .ico {
    position: absolute;
    left: 3px;
    top: 2px;
    width: 10px;
    height: 10px;
    --sn-background-size: "10px 10px";
    --sn-image-rendering: "pixelated";
}

.nav-btn .t-kbd {
    position: absolute;
    right: 2px;
    top: 3px;
}

.nav-btn:hover:enabled {
    background-color: var(--panel3);
    --ol: var(--violetL);
}

.nav-btn:disabled {
    color: var(--ink3);
    background-color: var(--navyD);
    --sn-cursor: "not-allowed";
}

.nav-btn:disabled .ico {
    opacity: .45;
}

.nav-btn:disabled .t-kbd {
    opacity: .45;
}

.nav-btn.ghost {
    background-color: var(--panel2);
    color: var(--ink2);
    padding-left: 5px;
}

.nav-btn.ghost:hover:enabled {
    background-color: var(--panel3);
    color: var(--ink);
}

.badge {
    position: absolute;
    right: 16px;
    top: 3px;
    min-width: 9px;
    height: 9px;
    --sn-line-height: "9px";
    --sn-text-align: "center";
    background-color: var(--coral);
    color: var(--creamL);
    padding: 0 1px;
    --sn-font-weight: "normal";
}

#center {
    position: absolute;
    left: 86px;
    top: 3px;
    width: 222px;
    bottom: 3px;
}

#mkt-head {
    position: relative;
    height: 14px;
    background-color: var(--panel);
    color: var(--ink);
    padding: 3px 3px 0 18px;
    transition: background .25s;
    --sn-box-shadow: "0 -1px 0 0 var(--line), 0 1px 0 0 var(--line), -1px 0 0 0 var(--line), 1px 0 0 0 var(--line), inset 3px 0 0 0 var(--mk)";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--line);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--line);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--line);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--line);
    --sn-bs-4: "inset 3 0 0 0";
    --sn-bsc-4: var(--mk);
}

#mkt-head .ico-box {
    position: absolute;
    left: 3px;
    top: 0;
    width: 14px;
    height: 13px;
}

#mkt-head .ico-box .t-canvas {
    position: absolute;
    left: 1px;
    top: 1px;
}

#mkt-head .nm {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-line-height: "9px";
    --sn-white-space: "nowrap";
    --sn-text-shadow: "1px 0 0 currentColor";
}

#mkt-head .px-price {
    position: absolute;
    right: 4px;
    top: 3px;
    --sn-line-height: "9px";
    color: var(--yellow);
}

#mkt-head.switch {
    --sn-animation: "slidein .3s cubic-bezier(.2, 1.4, .4, 1)";
}

#chart-wrap {
    position: relative;
    margin-top: 3px;
    height: 134px;
    background-color: var(--navy);
}

#chart {
    width: 222px;
    height: 134px;
}

#chart-wrap.switch {
    --sn-animation: "chartin .35s ease-out";
}

#chart-wrap.danger {
    --sn-animation: "dangerpulse .5s steps(2) infinite";
}

#btn-fast {
    position: absolute;
    left: 3px;
    bottom: 3px;
    background-color: var(--panel2);
    color: var(--ink);
    padding: 0 0 0 3px;
    --sn-line-height: "9px";
    height: 9px;
    opacity: .9;
    display: flex;
    --sn-display: "flex";
    --sn-box-shadow: "0 0 0 1px var(--line)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--line);
    flex-direction: row;
}

#btn-fast .t-kbd {
    margin-left: 2px;
    height: 9px;
    --sn-line-height: "9px";
    --sn-box-shadow: "none";
    --sn-bs-n: "0";
}

#btn-fast:hover {
    background-color: var(--violet);
}

#events {
    position: relative;
    margin-top: 3px;
    height: 38px;
    background-color: var(--panel);
    --sn-cursor: "pointer";
    overflow: hidden;
    --sn-box-shadow: "0 -1px 0 0 var(--line), 0 1px 0 0 var(--line), -1px 0 0 0 var(--line), 1px 0 0 0 var(--line), inset 3px 0 0 0 var(--tone, var(--line))";
    --sn-bs-n: "5";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--line);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--line);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--line);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--line);
    --sn-bs-4: "inset 3 0 0 0";
    --sn-bsc-4: var(--tone, var(--line));
}

#events:hover {
    background-color: var(--panel2);
}

#events .photo {
    position: absolute;
    left: 6px;
    top: 3px;
    width: 52px;
    height: 32px;
}

#events .tk {
    position: absolute;
    left: 62px;
    right: 3px;
    top: 3px;
    bottom: 2px;
}

#events .tk-k {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-line-height: "9px";
    color: var(--tone, var(--ink3));
    --sn-white-space: "nowrap";
    overflow: hidden;
    padding-right: 22px;
}

#events .tk-t {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-line-height: "9px";
    max-height: 18px;
    overflow: hidden;
    margin-top: 1px;
    color: var(--ink);
}

#events .tk-a {
    position: absolute;
    right: 0;
    top: 0;
    color: var(--tone);
}

#events.pos {
    --tone: var(--green);
}

#events.neg {
    --tone: var(--coral);
}

#events.neu {
    --tone: var(--orange);
}

#events.old .tk-t {
    color: var(--ink2);
}

#events.new {
    --sn-animation: "evin .5s cubic-bezier(.2, 1.6, .4, 1)";
}

#events.empty {
    --sn-cursor: "default";
    color: var(--ink3);
}

#trade {
    position: absolute;
    left: 311px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    background-color: var(--panel);
    padding: 4px;
}

.row-lbl {
    display: flex;
    --sn-display: "flex";
    justify-content: space-between;
    align-items: center;
    --sn-line-height: "9px";
    height: 10px;
    color: var(--ink2);
    flex-direction: row;
}

.row-lbl .t-kbd {
    margin: 0;
}

#amount {
    font-size: 16px;
    --sn-line-height: "16px";
    --sn-text-align: "center";
    color: var(--ink);
    margin: 3px 0 1px;
    --sn-white-space: "nowrap";
}

#amount.small {
    font-size: 8px;
}

#slider {
    position: relative;
    height: 5px;
    margin: 3px 1px 4px;
    background-color: var(--navyDD);
    --sn-cursor: "pointer";
    --sn-box-shadow: "0 0 0 1px var(--line)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--line);
}

#slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--yellow);
    --sn-box-shadow: "inset 0 1px 0 0 var(--yellowL)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 1 0 0";
    --sn-bsc-0: var(--yellowL);
}

#slider-knob {
    position: absolute;
    top: -2px;
    width: 3px;
    height: 9px;
    margin-left: -1px;
    background-color: var(--creamL);
    --sn-box-shadow: "0 0 0 1px var(--navyDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--navyDD);
}

.quick {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    flex-direction: row;
}

.quick .t-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    height: 11px;
    --sn-line-height: "10px";
    background-color: var(--panel2);
    color: var(--ink2);
}

.quick .t-button:hover {
    background-color: var(--panel3);
    color: var(--ink);
}

.quick .t-button.on {
    background-color: var(--yellow);
    color: var(--navyD);
    --ol: var(--yellowD);
}

#lev-box {
    margin-top: 6px;
}

.seg {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    margin-top: 1px;
    flex-direction: row;
}

.seg .t-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    height: 12px;
    --sn-line-height: "11px";
    background-color: var(--panel2);
    color: var(--ink2);
    position: relative;
}

.seg .t-button:hover:enabled {
    background-color: var(--panel3);
    color: var(--ink);
}

.seg .t-button.on {
    background-color: var(--cyan);
    --ol: var(--cyanL);
    color: var(--navyD);
}

.seg .t-button.hot.on {
    background-color: var(--orange);
    --ol: var(--orangeL);
}

.seg .t-button.max.on {
    background-color: var(--coral);
    --ol: var(--coralL);
    color: var(--creamL);
}

.seg .t-button:disabled {
    color: var(--ink3);
    background-color: var(--navyD);
    --sn-cursor: "not-allowed";
}

.seg .t-button.locked {
    color: var(--ink3);
    background-color: var(--navyD);
}

.seg .t-button.locked > .sn-before {
    --sn-content: "''";
    position: absolute;
    right: 2px;
    top: 1px;
    width: 1px;
    height: 1px;
    border-width: 1px;
    border-color: var(--ink3);
    border-bottom-width: 0;
}

.seg .t-button.locked > .sn-after {
    --sn-content: "''";
    position: absolute;
    right: 1px;
    top: 3px;
    width: 5px;
    height: 3px;
    background-color: var(--ink3);
}

.seg .t-button.locked:hover {
    color: var(--ink2);
    background-color: var(--panel2);
}

#risk {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "1px";
    margin: 3px 1px 0;
    height: 3px;
    flex-direction: row;
}

#risk .t-i {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    background-color: var(--navyDD);
}

#risk .t-i.on {
    background-color: var(--green);
}

#risk.r3 .t-i.on {
    background-color: var(--yellow);
}

#risk.r4 .t-i.on {
    background-color: var(--orange);
}

#risk.r5 .t-i.on {
    background-color: var(--coral);
}

#trade-buttons {
    margin-top: 5px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "6px";
}

.big-btn {
    position: relative;
    width: 100%;
    height: 34px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    justify-content: center;
    --sn-gap: "3px";
    padding: 0;
}

.big-btn .t-small {
    font-size: 8px;
    --sn-line-height: "8px";
    opacity: .8;
    --sn-text-shadow: "none";
}

#capital {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

#amount {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

#live-pnl {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

#goal-text {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

.px-price {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

.float {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

.num {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-text-shadow: "none";
}

.big-btn .t-span {
    font-size: 16px;
    --sn-line-height: "16px";
}

.big-btn .t-kbd {
    position: absolute;
    right: 3px;
    top: 3px;
    background-color: rgba(7, 10, 23, .55);
    color: var(--creamL);
    --sn-box-shadow: "none";
    --sn-bs-n: "0";
}

#btn-sell {
    --bg: #FF4F8B;
    --bgH: #FF8FB4;
}

#btn-skip-turn {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 4px;
}

#trade-live {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
}

.live-top {
    display: flex;
    --sn-display: "flex";
    justify-content: space-between;
    align-items: center;
    height: 11px;
    flex-direction: row;
}

#trade-live .dir {
    padding: 1px 4px 0;
    --sn-line-height: "10px";
    color: var(--navyD);
}

#trade-live .dir.long {
    background-color: var(--green);
}

#trade-live .dir.short {
    background-color: #FF4F8B;
    color: var(--creamL);
}

#live-bet {
    color: var(--ink2);
}

#live-pnl {
    font-size: 16px;
    --sn-line-height: "16px";
    --sn-text-align: "center";
    margin: 24px 0 6px;
    --sn-white-space: "nowrap";
}

#live-pnl.up {
    color: var(--green);
}

#live-pnl.down {
    color: var(--coral);
}

#live-steps {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "1px";
    height: 7px;
    margin: 4px 0 8px;
    flex-direction: row;
}

#live-steps .t-i {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 -1px 0 0 var(--navyDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--navyDD);
}

#live-steps .t-i.done {
    background-color: var(--cyan);
    --sn-box-shadow: "inset 0 -1px 0 0 var(--cyanD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--cyanD);
}

#live-steps .t-i.danger {
    --sn-background: "repeating-linear-gradient(135deg, var(--orange) 0 2px, var(--panel2) 2px 4px)";
}

#live-steps .t-i.danger.done {
    background-color: var(--orange);
    --sn-box-shadow: "inset 0 -1px 0 0 var(--orangeD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--orangeD);
}

#live-steps .t-i.ghost {
    opacity: .45;
}

#btn-close {
    position: relative;
    height: 50px;
    margin-top: 6px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    justify-content: center;
    --sn-gap: "4px";
    padding: 0;
}

#btn-close #close-lbl {
    font-size: 16px;
    --sn-line-height: "16px";
    letter-spacing: 1px;
}

#btn-close .t-kbd {
    position: absolute;
    left: 50%;
    bottom: -15px;
    --sn-transform: "translateX(-50%)";
    margin: 0;
}

#btn-close.losing {
    --bg: var(--panel3);
    --bgH: var(--line);
    --ink: var(--ink);
}

#btn-close.hot {
    --sn-animation: "pulse .5s steps(2) infinite";
}

#btn-close.done {
    --bg: var(--green);
    --sn-cursor: "default";
}

#btn-close.done .t-kbd {
    visibility: hidden;
}

#btn-close:disabled {
    --sn-filter: "none";
    opacity: 1;
    --sn-cursor: "default";
}

#btn-close.arming {
    opacity: .55;
}

#live-note {
    margin-top: auto;
    --sn-text-align: "center";
    --sn-line-height: "9px";
    min-height: 18px;
    color: var(--ink2);
}

#live-note.warn {
    color: var(--orange);
    --sn-animation: "pulse .5s steps(2) infinite";
}

#live-note.good {
    color: var(--green);
}

#live-note.bad {
    color: var(--coral);
}

.tip {
    position: absolute;
    --sn-z-index: "4";
    max-width: 160px;
    background-color: var(--navyDD);
    color: var(--yellow);
    padding: 3px 5px 2px;
    --sn-line-height: "9px";
    --sn-pointer-events: "none";
    --sn-box-shadow: "0 0 0 1px var(--yellow), 0 3px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "2";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--yellow);
    --sn-bs-1: "0 3 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .4);
    --sn-animation: "dlgin .3s cubic-bezier(.2, 1.5, .4, 1)";
}

.tip.out {
    --sn-animation: "tipout .3s steps(3) forwards";
}

.boom {
    position: absolute;
    font-size: 24px;
    --sn-line-height: "24px";
    --sn-white-space: "nowrap";
    --sn-pointer-events: "none";
    --sn-transform: "translate(-50%, -50%)";
    --sn-text-transform: "uppercase";
    --sn-text-shadow: "2px 0 0 var(--navyDD), -2px 0 0 var(--navyDD), 0 2px 0 var(--navyDD), 0 -2px 0 var(--navyDD), 2px 2px 0 var(--navyDD), -2px 2px 0 var(--navyDD), 0 4px 0 var(--navyDD)";
    --sn-animation: "boomin 1.35s cubic-bezier(.2, 1.8, .4, 1) forwards";
}

.boom.gain {
    color: var(--yellow);
}

.boom.loss {
    color: var(--coral);
}

.float {
    position: absolute;
    font-size: 16px;
    --sn-line-height: "16px";
    --sn-white-space: "nowrap";
    --sn-pointer-events: "none";
    --sn-text-shadow: "1px 0 0 var(--navyDD), -1px 0 0 var(--navyDD), 0 1px 0 var(--navyDD), 0 -1px 0 var(--navyDD), 0 2px 0 var(--navyDD)";
    --sn-animation: "floatup 2.4s cubic-bezier(.2, 1.4, .4, 1) forwards";
}

.float.gain {
    color: var(--green);
}

.float.loss {
    color: var(--coral);
    --sn-animation-name: "floatdown";
}

.float.gold {
    color: var(--yellow);
}

.float.small {
    font-size: 8px;
    --sn-line-height: "10px";
    --sn-animation-duration: "1.6s";
}

.result-card {
    position: absolute;
    --sn-z-index: "6";
    --sn-transform: "translate(-50%, -50%)";
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-gap: "4px";
    padding: 6px 14px 5px;
    background-color: var(--panel);
    --sn-box-shadow: "0 0 0 2px var(--navyDD), 0 0 0 4px var(--green), 0 0 0 6px var(--navyDD), 0 8px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 2";
    --sn-bsc-0: var(--navyDD);
    --sn-bs-1: "0 0 0 4";
    --sn-bsc-1: var(--green);
    --sn-bs-2: "0 0 0 6";
    --sn-bsc-2: var(--navyDD);
    --sn-bs-3: "0 8 0 0";
    --sn-bsc-3: rgba(0, 0, 0, .4);
    --sn-animation: "stampin .3s cubic-bezier(.2, 1.6, .4, 1) both";
}

.result-card.rc-lose {
    --sn-box-shadow: "0 0 0 2px var(--navyDD), 0 0 0 4px var(--coral), 0 0 0 6px var(--navyDD), 0 8px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 2";
    --sn-bsc-0: var(--navyDD);
    --sn-bs-1: "0 0 0 4";
    --sn-bsc-1: var(--coral);
    --sn-bs-2: "0 0 0 6";
    --sn-bsc-2: var(--navyDD);
    --sn-bs-3: "0 8 0 0";
    --sn-bsc-3: rgba(0, 0, 0, .4);
}

.result-card.rc-even {
    --sn-box-shadow: "0 0 0 2px var(--navyDD), 0 0 0 4px var(--ink3), 0 0 0 6px var(--navyDD), 0 8px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 2";
    --sn-bsc-0: var(--navyDD);
    --sn-bs-1: "0 0 0 4";
    --sn-bsc-1: var(--ink3);
    --sn-bs-2: "0 0 0 6";
    --sn-bsc-2: var(--navyDD);
    --sn-bs-3: "0 8 0 0";
    --sn-bsc-3: rgba(0, 0, 0, .4);
}

.result-card .rc-l {
    color: var(--ink2);
}

.result-card .rc-v {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    font-size: 24px;
    --sn-line-height: "24px";
    --sn-font-weight: "normal";
    color: var(--green);
}

.result-card.rc-lose .rc-v {
    color: var(--coral);
}

.result-card.rc-even .rc-v {
    color: var(--ink);
}

.result-card .rc-t {
    color: var(--ink);
}

.result-card .t-kbd {
    position: absolute;
    right: 2px;
    bottom: -11px;
}

.result-card.out {
    --sn-animation: "rcout .25s ease-in forwards";
}

.dlg {
    position: absolute;
    width: 292px;
    min-height: 54px;
    background-color: var(--navyDD);
    color: var(--ink);
    padding: 4px 6px 15px 50px;
    --sn-line-height: "10px";
    --sn-cursor: "pointer";
    --sn-box-shadow: "0 -1px 0 0 var(--violetL), 0 1px 0 0 var(--violetL), -1px 0 0 0 var(--violetL), 1px 0 0 0 var(--violetL), 0 -2px 0 0 var(--navyDD), 0 2px 0 0 var(--navyDD), -2px 0 0 0 var(--navyDD), 2px 0 0 0 var(--navyDD), 0 4px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "9";
    --sn-bs-0: "0 -1 0 0";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 1 0 0";
    --sn-bsc-1: var(--violetL);
    --sn-bs-2: "-1 0 0 0";
    --sn-bsc-2: var(--violetL);
    --sn-bs-3: "1 0 0 0";
    --sn-bsc-3: var(--violetL);
    --sn-bs-4: "0 -2 0 0";
    --sn-bsc-4: var(--navyDD);
    --sn-bs-5: "0 2 0 0";
    --sn-bsc-5: var(--navyDD);
    --sn-bs-6: "-2 0 0 0";
    --sn-bsc-6: var(--navyDD);
    --sn-bs-7: "2 0 0 0";
    --sn-bsc-7: var(--navyDD);
    --sn-bs-8: "0 4 0 0";
    --sn-bsc-8: rgba(0, 0, 0, .4);
    --sn-animation: "dlgin .3s cubic-bezier(.2, 1.5, .4, 1)";
    --sn-z-index: "3";
}

.dlg-catch {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    --sn-z-index: "2";
    --sn-cursor: "pointer";
}

.dlg.sticky {
    --sn-cursor: "default";
}

.dlg.bottom {
    bottom: 6px;
}

.dlg.top {
    top: 14px;
}

.dlg.left {
    left: 8px;
}

.dlg.right {
    right: 8px;
}

.dlg.center {
    left: 64px;
}

.dlg .portrait {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 40px;
    height: 40px;
    background-color: var(--coalD);
    --sn-box-shadow: "0 0 0 1px var(--violetD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violetD);
    overflow: hidden;
}

.dlg .portrait .t-canvas {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
}

.dlg .name {
    color: var(--yellow);
    --sn-line-height: "9px";
}

.dlg .txt {
    min-height: 30px;
}

.dlg .demo {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 56px;
    height: 34px;
    background-color: var(--creamL);
    --sn-box-shadow: "0 0 0 1px var(--creamDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--creamDD);
}

.dlg.has-demo {
    padding-right: 68px;
}

.dlg .next {
    position: absolute;
    right: 5px;
    bottom: 3px;
    color: var(--yellow);
    --sn-animation: "pulse .7s steps(2) infinite";
}

.dlg .next .t-kbd {
    background-color: var(--panel2);
    color: var(--ink);
    --sn-box-shadow: "0 0 0 1px var(--line)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--line);
    margin: 0 2px;
}

.dlg.sticky .next {
    display: none;
}

.dlg.glitchy .txt {
    --sn-animation: "textglitch 2.4s steps(1) infinite";
}

#layer-dialog > .spot {
    --sn-pointer-events: "none";
}

#layer-dialog > .spot-arrow {
    --sn-pointer-events: "none";
}

.spot {
    position: absolute;
    --sn-pointer-events: "none";
    --sn-z-index: "1";
    --sn-box-shadow: "0 0 0 1px var(--yellow), 0 0 0 2px var(--navyDD), 0 0 0 999px rgba(7, 5, 18, .62)";
    --sn-bs-n: "3";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--yellow);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    --sn-bs-2: "0 0 0 999";
    --sn-bsc-2: rgba(7, 5, 18, .62);
    --sn-animation: "spot 1s steps(2) infinite";
}

.spot-arrow {
    position: absolute;
    --sn-z-index: "1";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    --sn-pointer-events: "none";
    --sn-text-shadow: "1px 0 0 var(--navyDD), -1px 0 0 var(--navyDD), 0 1px 0 var(--navyDD), 0 -1px 0 var(--navyDD)";
    --sn-animation: "arrowbob .6s ease-in-out infinite alternate";
}

.win-back {
    position: absolute;
