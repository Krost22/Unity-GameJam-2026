    --sn-display: "flex";
    flex-direction: column;
}

.ac-cash .t-span {
    color: var(--ink2);
}

.ac-cash .t-b {
    color: var(--yellow);
    --sn-font-weight: "normal";
}

.ac-nav {
    --sn-grid-column: "1";
    --sn-grid-row: "2";
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
    padding: 3px;
}

.ac-nb {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    min-height: 18px;
    padding: 2px 3px;
    --sn-text-align: "left";
    --sn-line-height: "9px";
    color: var(--ink2);
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 0 0 1px var(--violetD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetD);
    --sn-transition: "transform .06s";
    position: relative;
    flex-direction: row;
}

.sh-nb {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    min-height: 18px;
    padding: 2px 3px;
    --sn-text-align: "left";
    --sn-line-height: "9px";
    color: var(--ink2);
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 0 0 1px var(--violetD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetD);
    --sn-transition: "transform .06s";
