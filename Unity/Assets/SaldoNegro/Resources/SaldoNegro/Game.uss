    --sn-transform: "translateX(1px)";
    --sn-box-shadow: "inset 0 0 0 1px var(--violetL)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetL);
}

.sh-nb:hover {
    color: var(--creamL);
    --sn-transform: "translateX(1px)";
    --sn-box-shadow: "inset 0 0 0 1px var(--violetL)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetL);
}

.ac-nb.on {
    color: var(--navyD);
    background-color: var(--green);
    --sn-box-shadow: "inset 0 0 0 1px var(--greenL), 0 0 0 1px var(--greenDD)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--greenL);
    --sn-bs-1: "0 0 0 1";
    --sn-bsc-1: var(--greenDD);
}

.sh-nb.on {
    color: var(--navyD);
    background-color: var(--green);
    --sn-box-shadow: "inset 0 0 0 1px var(--greenL), 0 0 0 1px var(--greenDD)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--greenL);
    --sn-bs-1: "0 0 0 1";
    --sn-bsc-1: var(--greenDD);
}

.ac-tree {
    --sn-grid-column: "2";
    --sn-grid-row: "2";
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    justify-content: space-around;
    padding: 2px 4px;
    overflow: hidden;
}

.ac-tree.in {
    --sn-animation: "slidein .15s steps(3)";
}

.sh-main.in {
    --sn-animation: "slidein .15s steps(3)";
}

.ac-br {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    flex-direction: row;
}

.ac-bl {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 67px;
    display: flex;
    --sn-display: "grid";
    flex-direction: column;
    --sn-grid-template-columns: "13px 1fr";
    --sn-gap: "0 2px";
    align-items: center;
    --sn-line-height: "9px";
}

.ac-bl .t-b {
    --sn-font-weight: "normal";
    --sn-text-shadow: "1px 0 0 currentColor";
}

.ac-bl .t-span {
    --sn-grid-column: "1 / 3";
