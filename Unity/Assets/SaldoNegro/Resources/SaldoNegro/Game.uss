    text-overflow: ellipsis;
    letter-spacing: -1px;
    font-size: 16px;
    --sn-line-height: "15px";
    color: var(--creamL);
    --sn-font-weight: "normal";
    --sn-text-shadow: "1px 0 0 currentColor";
}

.sh-btxt > .t-span {
    color: var(--ink2);
}

.sh-btxt .t-small {
    --sn-font-size: "inherit";
    color: var(--cyanL);
}

.sh-bpr {
    display: flex;
    --sn-display: "flex";
    --sn-align-items: "baseline";
    --sn-gap: "4px";
    margin: 1px 0;
    flex-direction: row;
}

.sh-bpr s {
    color: var(--ink3);
}

.sh-bpr .t-b {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    --sn-font-weight: "normal";
}

.sh-bpr .t-em {
    position: absolute;
    left: 2px;
    top: 2px;
    --sn-z-index: "1";
    --sn-font-style: "normal";
    padding: 1px 2px 0;
    color: var(--creamL);
    background-color: var(--coral);
    --sn-transform: "rotate(-8deg)";
    --sn-box-shadow: "0 0 0 1px var(--navyDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--navyDD);
}

.sh-bbtn {
    position: absolute;
    right: 4px;
    bottom: 4px;
    padding: 2px 6px 1px;
}

.sh-sec {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    color: var(--yellow);
    --sn-line-height: "10px";
    padding-left: 1px;
}

.sh-sec .t-em {
    --sn-font-style: "normal";
    color: var(--ink2);
}

.sh-grid {
    display: flex;
    --sn-display: "grid";
    flex-direction: column;
    --sn-grid-template-columns: "repeat(4, 1fr)";
    --sn-gap: "3px";
}

.sh-card {
    position: relative;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-gap: "1px";
    padding: 3px 1px 2px;
    min-height: 62px;
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 0 0 1px var(--violet), 0 2px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violet);
    --sn-bs-1: "0 2 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .4);
    --sn-transition: "transform .06s";
}

.sh-card:hover {
    --sn-transform: "translateY(-1px)";
    --sn-box-shadow: "inset 0 0 0 1px var(--violetL), 0 0 5px 0 rgba(168, 128, 255, .5)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 0 5 0";
    --sn-bsc-1: rgba(168, 128, 255, .5);
}

.sh-row:hover {
    --sn-transform: "translateY(-1px)";
    --sn-box-shadow: "inset 0 0 0 1px var(--violetL), 0 0 5px 0 rgba(168, 128, 255, .5)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 0 5 0";
    --sn-bsc-1: rgba(168, 128, 255, .5);
}

.sh-card .nm {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    width: 100%;
    color: var(--ink);
    --sn-line-height: "9px";
    --sn-text-align: "center";
    overflow: hidden;
    max-height: 27px;
}

.sh-card .pr {
    padding: 1px 3px 0;
    --sn-line-height: "9px";
    color: var(--navyD);
    background-color: var(--yellow);
    --sn-font-weight: "normal";
    --sn-white-space: "nowrap";
}

.sh-row .pr {
    padding: 1px 3px 0;
    --sn-line-height: "9px";
    color: var(--navyD);
    background-color: var(--yellow);
    --sn-font-weight: "normal";
    --sn-white-space: "nowrap";
}

.sh-card.poor .pr {
    background-color: var(--coralD);
    color: var(--creamL);
}

.sh-row.poor .pr {
    background-color: var(--coralD);
    color: var(--creamL);
}

.sh-card.own {
    background-color: var(--greenDD);
    --sn-box-shadow: "inset 0 0 0 1px var(--green)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--green);
}

.sh-card.own .pr {
    background-color: var(--green);
}

.sh-card.locked .px-ico {
    opacity: .45;
    --sn-filter: "grayscale(.6)";
}

.sh-row.locked .px-ico {
    opacity: .45;
    --sn-filter: "grayscale(.6)";
}

.sh-card.locked .pr {
    background-color: var(--navyL);
    color: var(--ink2);
}

.sh-card.gold {
    --sn-box-shadow: "inset 0 0 0 1px var(--yellowD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--yellowD);
}

.sh-card.sel {
    --sn-outline: "1px solid var(--creamL)";
    --sn-outline-offset: "1px";
}

.sh-row.sel {
    --sn-outline: "1px solid var(--creamL)";
    --sn-outline-offset: "1px";
}

.sh-empty {
    --sn-grid-column: "1 / 5";
    padding: 10px;
    color: var(--ink3);
    --sn-text-align: "center";
}

.sh-rows {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.sh-row {
    position: relative;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "5px";
    padding: 3px 5px;
    --sn-text-align: "left";
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 0 0 1px var(--violet), 0 2px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violet);
    --sn-bs-1: "0 2 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .4);
    --sn-transition: "transform .06s";
    flex-direction: row;
}

.sh-rt {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-line-height: "10px";
}

.sh-rt .t-b {
    color: var(--creamL);
    --sn-font-weight: "normal";
}

.sh-rt .t-b .t-em {
    --sn-font-style: "normal";
    color: var(--orange);
}

.sh-rt .t-span {
    color: var(--green);
}

.sh-row.locked .sh-rt .t-span {
    color: var(--ink3);
}

.sh-row.own .pr {
    background-color: var(--green);
}

.sh-dt {
    --sn-grid-column: "3";
    --sn-grid-row: "2";
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    padding: 0 4px 4px;
    --sn-text-align: "center";
    --sn-line-height: "9px";
    --sn-overflow-x: "hidden";
    --sn-overflow-y: "auto";
}

.sh-de {
    color: var(--green);
    margin-top: 1px;
}

.sh-dp {
    margin-top: 3px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
}

.sh-dp s {
    color: var(--ink3);
}

.sh-dp .t-b {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    --sn-font-weight: "normal";
}

.sh-dp .t-b.poor {
    color: var(--coralL);
}

.sh-dnote {
    margin-top: 2px;
    color: var(--ink2);
}

.sh-dnote.own {
    color: var(--greenL);
}

.sh-dnote.poor {
    color: var(--coralL);
}

.sh-dnote.locked {
    color: var(--coralL);
}

.cx {
    --sn-font-weight: "normal";
}

.cx-k {
    --sn-font-weight: "normal";
}

.cx-k {
    color: var(--cyan);
}

.paper .cx-k {
    color: var(--cyanD);
}

.ch-log .cx-k {
    color: var(--cyanD);
}

.nt .cx-k {
    color: var(--cyanD);
}

.tr-note .cx-k {
    color: var(--cyanD);
}

.cx-new {
    --sn-animation: "cxnew .45s steps(2) 4";
}

.stamp.cx-stamp {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-gap: "3px";
    color: var(--cyan);
    --sn-text-transform: "none";
    --sn-box-shadow: "0 0 0 2px var(--navyDD), 0 0 0 4px var(--cyan), 0 0 0 6px var(--navyDD), 0 8px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 2";
    --sn-bsc-0: var(--navyDD);
    --sn-bs-1: "0 0 0 4";
    --sn-bsc-1: var(--cyan);
    --sn-bs-2: "0 0 0 6";
    --sn-bsc-2: var(--navyDD);
    --sn-bs-3: "0 8 0 0";
    --sn-bsc-3: rgba(0, 0, 0, .4);
}

.stamp.cx-stamp .t-small {
    margin: 0;
}

.stamp.cx-stamp .cx-pair {
    font-size: 32px;
    --sn-line-height: "32px";
    color: var(--creamL);
}

.stamp.cx-stamp .cx-pair .cx {
    color: var(--magentaL);
}

#mkt-head .ico-box.skull {
    --sn-cursor: "pointer";
}

.knock {
    --sn-animation: "knock .18s steps(3)";
}

.dt-logo {
    --sn-z-index: "1";
    --sn-cursor: "default";
}

.dt-symbols {
    left: 96px;
    top: 14px;
    width: 220px;
    height: 176px;
}

.dt-symbols .dt-body {
    padding: 4px;
    --sn-overflow-y: "auto";
}

.sy-head {
    color: var(--ink2);
    margin-bottom: 3px;
}

.sy-grid {
    display: flex;
    --sn-display: "grid";
    flex-direction: column;
    --sn-grid-template-columns: "repeat(5, 1fr)";
    --sn-gap: "2px";
}

.sy-cell {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    --sn-gap: "2px";
    height: 14px;
    background-color: var(--navyD);
    color: var(--ink3);
    flex-direction: row;
}

.sy-cell .cx {
    color: var(--magentaL);
}

.sy-cell .t-i {
    --sn-font-style: "normal";
}

.sy-cell .q {
    --sn-font-weight: "normal";
    color: var(--ink3);
}

.sy-cell.on {
    background-color: var(--panel3);
    color: var(--ink);
}

.sy-cell.fresh {
    --sn-animation: "cxnew .45s steps(2) 4";
}

.sy-hints {
    margin-top: 5px;
    color: var(--ink2);
    --sn-line-height: "10px";
}

.sy-hints .t-b {
    --sn-font-weight: "normal";
    color: var(--yellow);
}

.sy-hints .t-p {
    margin: 2px 0 0;
}

.ch-tabs {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    padding: 2px 3px 0;
    background-color: var(--panel);
    flex-direction: row;
}

.ch-tab {
    position: relative;
    height: 11px;
    --sn-line-height: "10px";
    padding: 1px 6px 0;
    background-color: var(--navyD);
    color: var(--ink3);
}

.ch-tab.on {
    background-color: var(--panel2);
    color: var(--ink);
}

.ch-tab.ser .cx-k {
    color: var(--cyan);
}

.ch-msg.bravo .t-b {
    color: var(--yellow);
}

.ch-tab.bravo.on {
    color: var(--yellow);
}

.ch-tab .badge {
    position: relative;
    --sn-position: "static";
    display: flex;
    --sn-display: "inline-block";
    margin-left: 3px;
    --sn-vertical-align: "1px";
}

.ch-ava.ser {
    background-color: var(--coalDD);
    --sn-cursor: "pointer";
}

.ch-msg.ser {
    color: var(--coal);
    letter-spacing: 1px;
}

.ch-msg.ser .t-b.sn-first {
    color: var(--magentaD);
    letter-spacing: 0;
}

.ch-msg.hood .t-b.sn-first {
    color: var(--magentaD);
    letter-spacing: 0;
}

.ch-msg.hood {
    color: var(--coralD);
}

.nt-ghost {
    color: var(--coal);
    opacity: .14;
    --sn-cursor: "default";
}

.nt-ghost:hover {
    opacity: .35;
}

.nt-ghost.read {
    opacity: .6;
}

.tr-file.odd .t-span {
    color: var(--magentaL);
}

.tr-note .cx {
    letter-spacing: 1px;
}

.tr-note .cx-k {
    letter-spacing: 1px;
}

#app.lucky #titlebar {
    --sn-box-shadow: "inset 0 -1px 0 0 var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--yellow);
}

#clock .lk {
    --sn-font-weight: "normal";
    color: var(--yellow);
    margin-right: 3px;
    --sn-animation: "pulse 1.2s steps(2) infinite";
}

.daycard.lucky {
    --sn-box-shadow: "0 0 0 2px var(--navyDD), 0 0 0 4px var(--yellow), 0 0 0 6px var(--navyDD)";
    --sn-bs-n: "3";
    --sn-bs-0: "0 0 0 2";
    --sn-bsc-0: var(--navyDD);
    --sn-bs-1: "0 0 0 4";
    --sn-bsc-1: var(--yellow);
    --sn-bs-2: "0 0 0 6";
    --sn-bsc-2: var(--navyDD);
}

.daycard.lucky .d1 {
    color: var(--yellow);
    --sn-white-space: "nowrap";
    margin-bottom: 4px;
}

.daycard.lucky .lk-stars {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "8px";
    font-size: 16px;
    --sn-line-height: "16px";
    margin-bottom: 2px;
    flex-direction: row;
}

.daycard.lucky .lk-stars .t-i {
    --sn-font-style: "normal";
    color: var(--yellow);
    --sn-text-shadow: "0 2px 0 var(--magenta)";
    --sn-animation: "lkstar .8s steps(2) infinite";
}

.daycard.lucky .d3 {
    color: var(--ink2);
    margin-top: 3px;
}

#hud-days .free.lucky {
    color: var(--yellow);
}

.mcard .star {
    position: absolute;
    right: 2px;
    top: 1px;
    color: var(--yellow);
    --sn-font-weight: "normal";
    --sn-cursor: "pointer";
    --sn-animation: "pulse .9s steps(2) infinite";
}

.result-card .rc-luck {
    color: var(--yellow);
}

.sec-title.gold {
    color: var(--yellowL);
}

.shop-row.gold {
    --sn-box-shadow: "inset 2px 0 0 0 var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 2 0 0 0";
    --sn-bsc-0: var(--yellow);
    background-color: #2A2210;
}

.btn s {
    opacity: .6;
}

.rl {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "10px";
    align-items: flex-start;
    padding: 4px 6px;
    flex-direction: row;
}

.rl-wheel {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 96px;
    height: 96px;
    margin-top: 8px;
}

.rl-wheel .t-canvas {
    width: 96px;
    height: 96px;
    --sn-image-rendering: "auto";
}

.rl-arrow {
    position: absolute;
    left: 44px;
    top: -9px;
    color: var(--yellow);
    --sn-font-weight: "normal";
    --sn-z-index: "1";
}

.rl-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.rl-now {
    color: var(--yellow);
}

.rl-list {
    margin: 0;
    padding-left: 14px;
    color: var(--ink2);
    --sn-line-height: "10px";
}

.rl-list .t-li.on {
    color: var(--ink);
}

.rl-go {
    align-self: flex-start;
    padding: 3px 10px 2px;
}

.rl-res {
    min-height: 20px;
    color: var(--ink);
    --sn-line-height: "10px";
}

.rl-res .t-b {
    color: var(--yellow);
    --sn-font-weight: "normal";
}

#finale {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 305px;
    bottom: 3px;
    --sn-z-index: "3";
    display: flex;
    --sn-display: "flex";
    --sn-gap: "3px";
    background-color: var(--bg);
    flex-direction: row;
}

#finale.hidden {
    display: none;
}

#finale-trade.hidden {
    display: none;
}

.fz-side {
    width: 80px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "2px";
}

.fz-card {
    position: relative;
    height: 14px;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    padding: 0 3px;
    background-color: var(--panel);
    color: var(--ink2);
    --sn-line-height: "9px";
    flex-direction: row;
}

.fz-card .t-i {
    display: flex;
    --sn-display: "flex";
    flex-direction: row;
}

.fz-card .t-span {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    --sn-white-space: "nowrap";
    overflow: hidden;
}

.fz-card .t-b {
    --sn-font-weight: "normal";
    color: var(--coralL);
}

.fz-card.off {
    opacity: .5;
    --sn-filter: "grayscale(1)";
}

.fz-card.you {
    height: 24px;
    margin-top: 2px;
    background-color: var(--coralD);
    color: var(--creamL);
    --sn-box-shadow: "0 0 0 1px var(--coralL)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--coralL);
    --sn-animation: "fzPulse 1.2s steps(2) infinite";
}

.fz-card.you .t-b {
    color: var(--yellow);
}

.fz-main {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.fz-head {
    height: 14px;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    padding: 0 3px;
    background-color: var(--coralDD);
    color: var(--creamL);
    --sn-line-height: "9px";
    flex-direction: row;
}

.fz-head .t-i {
    display: flex;
    --sn-display: "flex";
    flex-direction: row;
}

.fz-price {
    margin-left: auto;
    color: var(--yellow);
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
}

#fz-chart {
    width: 222px;
    height: 140px;
    --sn-image-rendering: "pixelated";
}

.fz-warn {
    height: 13px;
    --sn-line-height: "13px";
    --sn-text-align: "center";
    background-color: var(--coral);
    color: var(--creamL);
    --sn-animation: "fzBlink 1s steps(2) infinite";
}

#finale.falling .fz-warn {
    background-color: var(--panel2);
    color: var(--ink3);
    --sn-animation: "none";
}

#app.finale #bet-box {
    display: none;
}

#app.finale #lev-box {
    display: none;
}

#app.finale #trade-buttons {
    display: none;
}

#finale-trade {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: stretch;
    --sn-gap: "5px";
    padding: 8px 2px 6px;
    --sn-text-align: "center";
}

#finale-trade .ft-t {
    color: var(--coralL);
    --sn-line-height: "10px";
}

#finale-trade .ft-or {
    color: var(--ink3);
    --sn-line-height: "8px";
}

#finale-trade .btn {
    padding: 3px 4px 2px;
}

.stamp.fin-warn {
    --sn-z-index: "5";
    font-size: 16px;
    --sn-line-height: "18px";
    --sn-text-align: "center";
}

#btn-x {
    background-color: var(--coralD);
    color: var(--creamL);
}

#btn-x.call {
    --sn-animation: "xCall .5s steps(2) infinite";
}

#app.absorb #hud {
    --sn-animation: "absorb 2.2s cubic-bezier(.6, 0, .9, .4) forwards";
    transform-origin: 50% 40%;
}

#app.absorb #body {
    --sn-animation: "absorb 2.2s cubic-bezier(.6, 0, .9, .4) forwards";
    transform-origin: 50% 40%;
}

#desk.gray {
    --sn-filter: "grayscale(1) contrast(1.15) brightness(.85)";
    --sn-transition: "filter 1.6s";
}

.offer.pact {
    width: 238px;
    --sn-box-shadow: "0 0 0 1px var(--coral), 0 0 0 2px var(--navyDD), 0 0 0 3px var(--magentaD), 4px 5px 0 3px rgba(7, 5, 18, .6)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--coral);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    --sn-bs-2: "0 0 0 3";
    --sn-bsc-2: var(--magentaD);
    --sn-bs-3: "4 5 0 3";
    --sn-bsc-3: rgba(7, 5, 18, .6);
}

.offer.pact .of-head .t-span {
    color: var(--coralL);
}

.pa-face {
    display: flex;
    --sn-display: "flex";
    justify-content: center;
    margin-top: 4px;
    flex-direction: row;
}

.pa-face .t-canvas {
    width: 60px;
    height: 69px;
    --sn-image-rendering: "pixelated";
}

.pa-lines {
    margin: 2px 8px 0;
}

.pa-lines .t-p {
    --sn-line-height: "11px";
    color: var(--creamL);
}

.offer .of-clause {
    color: var(--coralL);
    --sn-font-weight: "normal";
}

.dt-icon.ready .t-canvas {
    --sn-animation: "fzPulse 1s steps(2) infinite";
}

.dt-null {
    left: 66px;
    top: 6px;
    width: 262px;
    height: 206px;
}

.dt-term {
    left: 40px;
    top: 14px;
    width: 320px;
    height: 176px;
}

.nu {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 0;
    --sn-overflow-y: "auto";
    padding: 4px 6px;
    background-color: var(--navyDD);
    color: var(--ink);
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "3px";
}

.nu-err {
    color: var(--coral);
}

.nu-junk {
    color: var(--ink3);
    --sn-word-break: "break-all";
    --sn-line-height: "9px";
}

.nu-txt {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 0;
    --sn-overflow-y: "auto";
    --sn-line-height: "9px";
    color: var(--creamL);
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "5px";
}

.nu-txt .nu-h {
    color: var(--yellow);
}

.nu-run {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    align-self: center;
    margin-top: 3px;
    padding: 3px 10px 2px;
}

.tm {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    --sn-overflow-y: "auto";
    padding: 4px 5px;
    background-color: #07061A;
    color: var(--green);
    --sn-line-height: "9px";
}

.tm .t-p {
    --sn-white-space: "pre-wrap";
}

.tm-cmd {
    color: var(--creamL);
}

.tm-lock {
    color: var(--coral);
}

.tm-hint {
    color: var(--ink3);
    --sn-animation: "caret 1s steps(2) infinite";
}

.tm .caret {
    display: flex;
    --sn-display: "inline-block";
    width: 4px;
    height: 7px;
    margin-left: 1px;
    background-color: var(--green);
    --sn-animation: "caret 1s steps(2) infinite";
}

#stage-top {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    --sn-z-index: "30";
    --sn-pointer-events: "none";
}

#stage-top > * {
    --sn-pointer-events: "auto";
}

.fin-panel {
    --sn-animation: "offerin .2s steps(3)";
}

.fin-panel.out {
    --sn-animation: "none";
    opacity: 0;
    transition: opacity .25s;
}

.fin-next {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    margin: 6px auto 0;
    padding: 3px 10px 2px;
}

.fin-letter {
    position: absolute;
    left: 50%;
    top: 50%;
    --sn-z-index: "6";
    width: 250px;
    --sn-transform: "translate(-50%, -50%)";
    padding: 0 8px 7px;
    background-color: var(--navyD);
    color: var(--ink);
    --sn-box-shadow: "0 0 0 1px var(--yellow), 0 0 0 2px var(--navyDD), 4px 5px 0 3px rgba(7, 5, 18, .6)";
    --sn-bs-n: "3";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--yellow);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    --sn-bs-2: "4 5 0 3";
    --sn-bsc-2: rgba(7, 5, 18, .6);
}

.fin-letter .lt-head {
    margin: 0 -8px 5px;
    padding: 2px 4px 1px;
    background-color: var(--navyDD);
    color: var(--yellow);
    letter-spacing: 1px;
}

.fin-letter .t-p {
    --sn-line-height: "10px";
    margin-top: 2px;
}

.lt-gift {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    --sn-gap: "6px";
    margin: 6px 0 2px;
    flex-direction: row;
}

.lt-gift .t-canvas {
    width: 24px;
    height: 32px;
    --sn-image-rendering: "pixelated";
}

.lt-gift .t-b {
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--green);
    --sn-font-weight: "normal";
}

.lt-foot {
    --sn-text-align: "center";
    color: var(--ink2);
}

.fin-paper {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    --sn-transform: "translate(-50%, -50%) rotate(-1deg)";
    padding: 6px 10px 8px;
    background-color: var(--creamL);
    color: var(--coal);
    --sn-box-shadow: "4px 5px 0 2px rgba(7, 5, 18, .55)";
    --sn-bs-n: "1";
    --sn-bs-0: "4 5 0 2";
    --sn-bsc-0: rgba(7, 5, 18, .55);
}

.fin-paper .np-front {
    --sn-grid-template-columns: "172px 1fr";
}

.fin-paper .np-ph .t-canvas {
    width: 172px;
    height: 108px;
    --sn-image-rendering: "pixelated";
}

.fin-paper .t {
    margin-top: 2px;
}

.fin-paper .cap {
    margin-top: 4px;
    color: var(--coalL);
    --sn-font-style: "italic";
    --sn-line-height: "9px";
}

.fin-credits {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    justify-content: center;
    --sn-gap: "3px";
    background-color: #07061A;
    color: var(--ink2);
    --sn-text-align: "center";
}

.fin-credits .cr-fin {
    font-size: 32px;
    --sn-line-height: "32px";
    color: var(--creamL);
    letter-spacing: 6px;
    margin-bottom: 10px;
}

.fin-credits .cr-title {
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    margin-bottom: 6px;
    letter-spacing: 2px;
}

.fin-credits .cr-final {
    margin-top: 8px;
    color: var(--coralL);
}

.fin-credits .cr-pala {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "5px";
    color: var(--green);
    flex-direction: row;
}

.fin-credits .cr-pala .t-canvas {
    width: 18px;
    height: 24px;
    --sn-image-rendering: "pixelated";
}

.fin-comic {
    position: absolute;
    --sn-transform: "translate(-50%, -50%) rotate(var(--r))";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
    --sn-text-shadow: "1px 0 0 var(--coal), -1px 0 0 var(--coal), 0 1px 0 var(--coal), 0 -1px 0 var(--coal), 2px 2px 0 var(--coralD)";
    --sn-animation: "comic 1.1s steps(4) forwards";
    --sn-pointer-events: "none";
}

.fin-dust {
    position: absolute;
    left: 30px;
    top: 270px;
    width: 12px;
    height: 12px;
    --sn-pointer-events: "none";
    background-color: var(--creamD);
    --sn-box-shadow: "12px -6px 0 2px var(--creamD), 24px 0 0 4px var(--cream), 36px -8px 0 1px var(--creamD), 6px 10px 0 3px var(--cream), 30px 10px 0 2px var(--creamD)";
    --sn-bs-n: "5";
    --sn-bs-0: "12 -6 0 2";
    --sn-bsc-0: var(--creamD);
    --sn-bs-1: "24 0 0 4";
    --sn-bsc-1: var(--cream);
    --sn-bs-2: "36 -8 0 1";
    --sn-bsc-2: var(--creamD);
    --sn-bs-3: "6 10 0 3";
    --sn-bsc-3: var(--cream);
    --sn-bs-4: "30 10 0 2";
    --sn-bsc-4: var(--creamD);
    --sn-animation: "dust 3.4s steps(8) forwards";
}

.fin-panel.fin-credits {
    --sn-animation: "fadein .6s steps(6)";
}
