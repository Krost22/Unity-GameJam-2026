}

.ac-br.orange .ac-bl .t-b {
    color: var(--orange);
}

.ac-br.cyan .ac-bl .t-b {
    color: var(--cyan);
}

.ac-br.violet .ac-bl .t-b {
    color: var(--magentaL);
}

.ac-ln {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 4px;
    height: 2px;
    background-color: var(--violetD);
}

.ac-ln.on {
    background-color: var(--cyan);
    --sn-box-shadow: "0 0 3px var(--cyan)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 3 0";
    --sn-bsc-0: var(--cyan);
}

.ac-n {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 28px;
    height: 36px;
    padding: 2px 0 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-gap: "1px";
    background-color: var(--panel2);
    --sn-box-shadow: "inset 0 0 0 1px var(--violet), 0 2px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violet);
    --sn-bs-1: "0 2 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .4);
    --sn-transition: "transform .06s";
}

.ac-n .t-em {
    --sn-font-style: "normal";
    --sn-line-height: "8px";
    color: var(--ink2);
}

.ac-n:hover {
    --sn-transform: "translateY(-1px)";
}

.ac-n .ac-lock {
    position: absolute;
    right: 1px;
    top: 1px;
}

.sh-card .sh-lock {
    position: absolute;
    right: 1px;
    top: 1px;
}

.sh-row .sh-lock {
    position: absolute;
    right: 1px;
    top: 1px;
}

.ac-n.can {
    --sn-box-shadow: "inset 0 0 0 1px var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--yellow);
    --sn-animation: "glowy 1.2s steps(2) infinite";
}

.ac-n.can .t-em {
    color: var(--yellow);
}

.ac-n.own {
    background-color: var(--greenDD);
    --sn-box-shadow: "inset 0 0 0 1px var(--greenL), 0 2px 0 0 rgba(0, 0, 0, .4)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--greenL);
    --sn-bs-1: "0 2 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .4);
}

.ac-n.own .t-em {
    color: var(--greenL);
}

.ac-n.locked .px-ico {
    opacity: .45;
    --sn-filter: "grayscale(.6)";
}

.ac-n.soon .px-ico {
    opacity: .45;
    --sn-filter: "grayscale(.6)";
}

.ac-n.soon {
    background-color: var(--navyDD);
}

.ac-n.sel {
    --sn-outline: "1px solid var(--creamL)";
    --sn-outline-offset: "1px";
}

.ac-n.bump {
    --sn-animation: "bump .24s steps(4)";
}

.sh-card.bump {
    --sn-animation: "bump .24s steps(4)";
}

.sh-row.bump {
    --sn-animation: "bump .24s steps(4)";
}

.ac-dt.bump .ac-dico {
    --sn-animation: "bump .24s steps(4)";
}

.sh-dt.bump .sh-dico {
    --sn-animation: "bump .24s steps(4)";
}

.ac-n.done {
    --sn-animation: "donepop .5s steps(5)";
}

.ac-list {
    margin-top: 3px;
    --sn-line-height: "10px";
    color: var(--ink2);
    --sn-overflow-y: "auto";
}

.ac-list .t-p {
