}

.nt .kw-risk {
    color: var(--coralD);
}

#hero-say .kw-risk {
    color: var(--coralD);
}

.paper .kw-act {
    color: var(--yellowDD);
}

.nt .kw-act {
    color: var(--yellowDD);
}

#hero-say .kw-act {
