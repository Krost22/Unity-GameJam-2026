}

.ab-seal {
    margin-left: auto;
    width: 22px;
    height: 22px;
    font-size: 16px;
    --sn-line-height: "20px";
    color: var(--magentaL);
    background-color: var(--navyD);
    --sn-box-shadow: "inset 0 0 0 1px var(--magenta)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--magenta);
    --sn-animation: "pulse 2.6s steps(2) infinite";
}

.ab-seal.read {
    color: var(--cyan);
    --sn-box-shadow: "inset 0 0 0 1px var(--cyan)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--cyan);
    --sn-animation: "none";
}

#hero-say {
    position: absolute;
    left: 172px;
    bottom: 66px;
    max-width: 270px;
    padding: 4px 7px 3px;
    --sn-z-index: "6";
    --sn-pointer-events: "none";
    background-color: #FFF6E0;
    color: #241B33;
    font-size: 8px;
    --sn-line-height: "10px";
    --sn-box-shadow: "0 0 0 1px #241B33, 0 0 0 2px #FFF6E0, 0 0 0 3px #241B33, 3px 4px 0 2px rgba(0, 0, 0, .35)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: #241B33;
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: #FFF6E0;
    --sn-bs-2: "0 0 0 3";
    --sn-bsc-2: #241B33;
    --sn-bs-3: "3 4 0 2";
    --sn-bsc-3: rgba(0, 0, 0, .35);
}

#hero-say > .sn-after {
    --sn-content: "''";
    position: absolute;
    left: 22px;
    bottom: -6px;
    width: 0;
    height: 0;
    border-left-width: 5px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-width: 3px;
    border-right-color: rgba(0, 0, 0, 0);
    border-top-width: 6px;
    border-top-color: #241B33;
}

#hero-say > .sn-before {
    --sn-content: "''";
    position: absolute;
    left: 23px;
    bottom: -3px;
    width: 0;
    height: 0;
    --sn-z-index: "1";
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-width: 2px;
    border-right-color: rgba(0, 0, 0, 0);
    border-top-width: 4px;
    border-top-color: #FFF6E0;
}

#hero-say.in {
    --sn-animation: "saypop .18s steps(3)";
}

#hero-say.out {
    --sn-animation: "sayout .22s steps(3) forwards";
}

#hero-say .kw-gold {
    --g1: #B07800;
    --g2: #F2B53A;
}

#hero-say .kw-luck {
    color: var(--greenD);
}

