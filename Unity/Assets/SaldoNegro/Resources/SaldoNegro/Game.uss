}

.overlay-panel .t2 {
    color: var(--ink);
    max-width: 300px;
    --sn-line-height: "10px";
}

.overlay-panel .t3 {
    color: var(--ink2);
    max-width: 300px;
    --sn-line-height: "10px";
}

.overlay-panel .row {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "8px";
    margin-top: 6px;
    flex-direction: row;
}

.embargo {
    background-color: var(--coralD);
}

.embargo .t1 {
    color: var(--creamL);
    font-size: 24px;
    --sn-line-height: "24px";
}

.embargo .t2 {
    color: var(--creamL);
}

.rescue-ui {
    --sn-z-index: "8";
    background-color: rgba(7, 5, 18, .78);
    --sn-animation: "dayin .3s steps(4) both";
}

.rescue-ui .t1 {
    --sn-animation: "popin .5s .5s cubic-bezier(.2, 1.8, .4, 1) both";
    max-width: 330px;
}

.rescue-ui .t2 {
    --sn-animation: "dlgin .4s .8s both";
}

.rescue-ui .t3 {
    --sn-animation: "dlgin .4s 1s both";
}

.rescue-ui .row {
    --sn-animation: "dlgin .4s 1.2s both";
}

.rc-receipt {
    width: 210px;
    padding: 6px 8px 7px;
    background-color: var(--creamL);
    color: var(--coal);
    --sn-text-align: "left";
    --sn-box-shadow: "0 0 0 1px var(--coal), 0 0 0 2px var(--yellow), 4px 5px 0 2px rgba(7, 5, 18, .6)";
    --sn-bs-n: "3";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--coal);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--yellow);
    --sn-bs-2: "4 5 0 2";
    --sn-bsc-2: rgba(7, 5, 18, .6);
    --sn-animation: "receipt .45s cubic-bezier(.2, 1.5, .4, 1) both";
}

.rc-h {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "5px";
    padding-bottom: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--creamD);
    --sn-border-bottom: "1px dashed var(--creamD)";
    color: var(--greenDD);
    flex-direction: row;
}

.rc-h .t-canvas {
    --sn-image-rendering: "pixelated";
}

.rc-row {
    display: flex;
    --sn-display: "flex";
    justify-content: space-between;
    --sn-gap: "8px";
    --sn-line-height: "10px";
    flex-direction: row;
}

.rc-row .t-span {
    color: var(--creamDD);
}

.rc-amt {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--creamD);
    --sn-border-top: "1px dashed var(--creamD)";
    --sn-text-align: "right";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--greenD);
}

.px-font {
    --sn-font-family: "'SaldoPixel', monospace";
    font-size: 8px;
    --sn-line-height: "10px";
    --sn-font-weight: "normal";
    --sn-font-synthesis: "none";
    --sn--webkit-font-smoothing: "none";
}

#subs {
    position: absolute;
    --sn-position: "fixed";
    left: 50%;
    --sn-bottom: "3vh";
    max-width: 460px;
    padding: 4px 8px 3px;
    --sn-text-align: "center";
    transform-origin: bottom 50%;
    --sn-transform: "translateX(-50%) scale(var(--k, 2))";
    background-color: rgba(7, 5, 18, .92);
    color: var(--ink);
    --sn-box-shadow: "0 0 0 1px var(--violet)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violet);
    --sn-z-index: "10";
    --sn-user-select: "none";
}

#subs .t-b {
    color: var(--yellow);
    --sn-font-weight: "normal";
}

#subs.top {
    --sn-top: "3vh";
    bottom: auto;
    transform-origin: top 50%;
}

#subs.click {
    --sn-cursor: "pointer";
}

#subs.click > .sn-after {
    --sn-content: "' ▶'";
    color: var(--yellow);
    --sn-animation: "pulse .7s steps(2) infinite";
}

#btn-skip {
    position: absolute;
    --sn-position: "fixed";
    right: 12px;
    top: 12px;
    transform-origin: top right;
    --sn-transform: "scale(var(--k, 2))";
    background-color: rgba(7, 5, 18, .85);
    color: var(--ink2);
    padding: 1px 4px 0;
    --sn-z-index: "11";
    --sn-box-shadow: "0 0 0 1px var(--violet)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violet);
    border-width: 0;
    --sn-cursor: "pointer";
}

#btn-skip:hover {
    color: var(--yellow);
}

#fade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: #0b0716;
    opacity: 0;
    --sn-pointer-events: "none";
    --sn-z-index: "20";
}

.notif {
    position: absolute;
    width: 150px;
    padding: 3px 5px 2px 16px;
    background-color: var(--navy);
    color: var(--ink);
    --sn-line-height: "10px";
    --sn-box-shadow: "0 0 0 1px var(--violetL), 0 3px 0 0 rgba(0, 0, 0, .45)";
    --sn-bs-n: "2";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 3 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .45);
    --sn-animation: "notifin .35s cubic-bezier(.2, 1.7, .4, 1) both";
    --sn-z-index: "9";
}

.notif > .sn-before {
    --sn-content: "'!'";
    position: absolute;
    left: 4px;
    top: 3px;
    width: 8px;
    height: 8px;
    --sn-line-height: "8px";
    --sn-text-align: "center";
    background-color: var(--coral);
    color: var(--creamL);
}

.debt-text {
    position: absolute;
    left: 0;
    right: 0;
    --sn-text-align: "center";
    font-size: 16px;
    --sn-line-height: "16px";
    --sn-z-index: "9";
}

.debt-text.green {
    color: var(--green);
}

.debt-text.coral {
    color: var(--coral);
}

.debt-text.yellow {
    color: var(--yellow);
}

.debt-text.orange {
    color: var(--orange);
}

#rotate {
    display: none;
    position: absolute;
    --sn-position: "fixed";
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    --sn-z-index: "50";
    background-color: var(--coalD);
    color: var(--yellow);
    align-items: center;
    justify-content: center;
    --sn-text-align: "center";
}

#rotate .t-span {
    --sn-transform: "scale(3)";
    --sn-line-height: "12px";
}

#screen.glitch {
    --sn-animation: "glitch .18s steps(2) infinite";
}

.locked-ui {
    --sn-pointer-events: "none";
}

.tut-allow {
    --sn-pointer-events: "auto";
    position: relative;
    --sn-z-index: "2";
}

#btn-min {
    position: relative;
}

#btn-min .ico-min {
    width: 7px;
    height: 7px;
    --sn-background-size: "7px 7px";
    --sn-image-rendering: "pixelated";
}

#btn-min .badge {
    right: auto;
    left: -11px;
    top: 0;
}

#app.minimizing {
    --sn-animation: "appmin .22s steps(5) forwards";
    transform-origin: 8% 100%;
    --sn-pointer-events: "none";
}

#app.restoring {
    --sn-animation: "appmin .22s steps(5) reverse";
    transform-origin: 8% 100%;
}

#desktop {
    background-color: var(--navyDD);
    overflow: hidden;
}

.dt-wall {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 14px;
    left: 0;
    --sn-background: "radial-gradient(circle at 70% 45%, rgba(255, 79, 139, .35), transparent 55%), linear-gradient(180deg, #2B1B4F 0%, #4A1F5E 60%, #1B1538 100%)";
}

.dt-wall > .sn-after {
    --sn-content: "''";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    opacity: .25;
    --sn-background-image: "linear-gradient(var(--violetD) 1px, transparent 1px), linear-gradient(90deg, var(--violetD) 1px, transparent 1px)";
    --sn-background-size: "12px 12px";
}

.dt-logo {
    position: absolute;
    right: 40px;
    top: 50%;
    --sn-transform: "translateY(-50%)";
    font-size: 64px;
    --sn-line-height: "64px";
    color: rgba(255, 220, 240, .14);
    --sn-text-shadow: "0 0 0 transparent, 2px 2px 0 rgba(255, 79, 139, .35), -2px -2px 0 rgba(94, 233, 255, .25)";
    letter-spacing: 4px;
}

.dt-icons {
    position: absolute;
    left: 4px;
    top: 4px;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "2px";
    --sn-z-index: "1";
}

.dt-icon {
    position: relative;
    width: 50px;
    padding: 2px 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: center;
    --sn-gap: "2px";
    color: var(--creamL);
    --sn-text-shadow: "1px 1px 0 var(--navyDD)";
}

.dt-icon:hover {
    background-color: rgba(255, 255, 255, .12);
    --sn-box-shadow: "0 0 0 1px rgba(255, 255, 255, .25)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: rgba(255, 255, 255, .25);
}

.dt-icon .badge {
    right: 8px;
    top: 0;
}

.dt-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    padding: 0 3px;
    background-color: var(--navyD);
    --sn-box-shadow: "inset 0 1px 0 0 var(--violet)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 1 0 0";
    --sn-bsc-0: var(--violet);
    --sn-z-index: "5";
    flex-direction: row;
}

.dt-start {
    height: 10px;
    --sn-line-height: "10px";
    padding: 0 4px;
    background-color: var(--green);
    color: var(--navyD);
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "2px";
    flex-direction: row;
}

.dt-start:hover {
    background-color: var(--greenL);
}

.dt-tasks {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    overflow: hidden;
    flex-direction: row;
}

.dt-task {
    height: 10px;
    --sn-line-height: "10px";
    padding: 0 4px;
    background-color: var(--panel2);
    color: var(--ink2);
    --sn-white-space: "nowrap";
}

.dt-task.on {
    background-color: var(--panel3);
    color: var(--ink);
    --sn-box-shadow: "inset 0 -1px 0 0 var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--yellow);
}

.dt-task.min {
    color: var(--yellow);
}

.dt-task:hover {
    background-color: var(--violet);
    color: var(--creamL);
}

.dt-clock {
    color: var(--ink2);
    --sn-white-space: "nowrap";
}

.dt-win {
    position: absolute;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    background-color: var(--panel);
    --sn-box-shadow: "0 0 0 1px var(--violetL), 0 0 0 2px var(--navyDD), 3px 3px 0 2px rgba(7, 5, 18, .5)";
    --sn-bs-n: "3";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--violetL);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    --sn-bs-2: "3 3 0 2";
    --sn-bsc-2: rgba(7, 5, 18, .5);
    --sn-animation: "winin .14s steps(3)";
}

.dt-win.top {
    --sn-z-index: "3";
}

.dt-head {
    height: 11px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: space-between;
    padding: 0 1px 0 4px;
    background-color: var(--violet);
    color: var(--creamL);
    flex-direction: row;
}

.dt-x {
    width: 9px;
    height: 9px;
    --sn-line-height: "9px";
    --sn-text-align: "center";
    background-color: var(--coral);
    color: var(--creamL);
}

.dt-x:hover {
    background-color: var(--coralL);
}

.dt-body {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 0;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
}

.dt-chat {
    left: 66px;
    top: 6px;
    width: 262px;
    height: 206px;
}

.dt-notes {
    left: 92px;
    top: 14px;
    width: 246px;
    height: 148px;
}

.dt-notes .dt-body {
    background-color: var(--creamL);
    --sn-overflow-y: "auto";
    --sn-overflow-x: "hidden";
}

.dt-notes .dt-body.sn-scrollbar {
    width: 4px;
}

.dt-notes .dt-body.sn-scrollbar-thumb {
    background-color: var(--violet);
}

.nt {
    margin: 0;
    padding: 4px 6px;
    --sn-font: "inherit";
    color: var(--coal);
    --sn-white-space: "pre-wrap";
    --sn-overflow-wrap: "anywhere";
    --sn-line-height: "11px";
}

.dt-trash {
    left: 150px;
    top: 60px;
    width: 180px;
    height: 96px;
}

.tr-list {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-gap: "1px";
    padding: 3px;
}

.tr-file {
    display: flex;
    --sn-display: "flex";
    justify-content: space-between;
    padding: 1px 3px;
    background-color: var(--panel2);
    color: var(--ink);
    --sn-text-align: "left";
    flex-direction: row;
}

.tr-file:hover {
    background-color: var(--violet);
}

.tr-file .t-em {
    --sn-font-style: "normal";
    color: var(--ink3);
}

.tr-note {
    margin-top: auto;
    padding: 2px 4px;
    color: var(--yellow);
    background-color: var(--navyD);
}

.ch-who {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "4px";
    padding: 3px 4px;
    background-color: var(--panel2);
    flex-direction: row;
}

.ch-ava {
    width: 24px;
    height: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    background-color: var(--cyan);
    --sn-box-shadow: "0 0 0 1px var(--navyDD)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--navyDD);
}

.ch-who > .t-div {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
}

.ch-who .t-b {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    color: var(--ink);
    --sn-font-weight: "normal";
    --sn-text-shadow: "1px 0 0 currentColor";
    --sn-white-space: "nowrap";
    overflow: hidden;
    text-overflow: ellipsis;
}

.ch-ava .t-canvas {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    width: 24px;
    height: 24px;
    --sn-image-rendering: "pixelated";
}

.ac-ava .t-canvas {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    width: 24px;
    height: 24px;
    --sn-image-rendering: "pixelated";
}

.ch-status {
    color: var(--green);
}

.ch-status > .sn-before {
    --sn-content: "'● '";
}

.ch-status.off {
    color: var(--ink3);
}

.ch-log {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 0;
    --sn-overflow-y: "auto";
    padding: 3px 5px;
    background-color: var(--creamL);
    color: var(--coal);
}

.ch-log .t-p {
    margin: 0 0 3px;
    --sn-line-height: "10px";
}

.ch-msg {
    padding-left: 6px;
}

.ch-msg.first {
    margin-top: 5px;
}

.ch-msg.first .t-b {
    margin-left: -6px;
}

.ch-msg.first.sn-first {
    margin-top: 0;
}

.ch-msg .t-b {
    display: flex;
    --sn-display: "block";
    flex-direction: column;
    --sn-font-weight: "normal";
    color: var(--violetD);
}

.ch-msg.m .t-b {
    color: var(--greenD);
}

.ch-sys {
    color: #8E7FA8;
    --sn-text-align: "center";
}

.ch-typing {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    height: 10px;
    --sn-line-height: "10px";
    padding: 0 5px;
    color: var(--ink3);
    background-color: var(--panel);
}

.ch-input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    display: flex;
    --sn-display: "flex";
    --sn-gap: "3px";
    padding: 3px;
    background-color: var(--panel2);
    flex-direction: row;
}

.ch-box {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 22px;
    padding: 2px 3px;
    --sn-line-height: "10px";
    background-color: var(--creamL);
    color: var(--coal);
    --sn-box-shadow: "inset 0 0 0 1px var(--line)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--line);
    --sn-cursor: "default";
}

.ch-box.live {
    --sn-cursor: "default";
    --sn-box-shadow: "inset 0 0 0 1px var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--yellow);
}

.ch-box .ph {
    color: #8E7FA8;
}

.ch-box .ph .t-kbd {
    margin-left: 3px;
}

.caret {
    display: flex;
    --sn-display: "inline-block";
    width: 1px;
    height: 8px;
    margin-left: 1px;
    background-color: var(--coal);
    --sn-vertical-align: "-1px";
    --sn-animation: "blink .8s steps(1) infinite";
}

.ch-send {
    width: 46px;
    flex-direction: column;
    --sn-gap: "2px";
    padding: 0;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
}

.ch-send:disabled {
    --sn-filter: "grayscale(.8) brightness(.7)";
    --sn-cursor: "default";
}

.ch-send.ready {
    --sn-animation: "pulse .6s steps(2) infinite";
}

.nudge {
    --sn-animation: "nudge .45s steps(8)";
}

.msg-toast {
    position: absolute;
    left: 89px;
    bottom: 5px;
    width: 218px;
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "4px";
    padding: 3px 4px;
    --sn-text-align: "left";
    background-color: var(--panel);
    color: var(--ink);
    --sn-box-shadow: "0 0 0 1px var(--green), 0 0 0 2px var(--navyDD)";
    --sn-bs-n: "2";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--green);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    flex-direction: row;
}

.msg-toast.show {
    --sn-animation: "notifin .25s steps(4)";
}

.msg-toast > .t-i {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 16px;
    height: 16px;
}

.msg-toast .t-b {
    color: var(--green);
    --sn-font-weight: "normal";
}

.msg-toast .t-span {
    --sn-line-height: "10px";
}

.msg-toast:hover {
    --sn-box-shadow: "0 0 0 1px var(--greenL), 0 0 0 2px var(--navyDD)";
    --sn-bs-n: "2";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--greenL);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
}

.ch-log.sn-scrollbar {
    width: 4px;
}

.ch-log.sn-scrollbar-track {
    background-color: var(--cream);
}

.ch-log.sn-scrollbar-thumb {
    background-color: var(--violetL);
}

.ch-log {
    --sn-scrollbar-width: "thin";
    --sn-scrollbar-color: "var(--violetL) var(--cream)";
}

.final-loss {
    --sn-z-index: "8";
    background-color: rgba(7, 5, 18, .9);
    --sn-animation: "dayin .4s steps(6) both";
}

.final-loss .t1 {
    font-size: 24px;
    --sn-line-height: "24px";
    color: var(--coral);
}

#hud-goal .bar .t-i.item {
    background-color: var(--cyan);
    --sn-box-shadow: "inset 0 2px 0 0 var(--cyanL), inset 0 -1px 0 0 var(--cyanD)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 2 0 0";
    --sn-bsc-0: var(--cyanL);
    --sn-bs-1: "inset 0 -1 0 0";
    --sn-bsc-1: var(--cyanD);
}

#btn-item {
    position: absolute;
    top: 2px;
    right: 3px;
    bottom: 3px;
    left: 3px;
    --sn-text-align: "center";
    --sn-line-height: "16px";
    padding: 0;
    --sn-z-index: "2";
}

#btn-item .t-kbd {
    margin-left: 3px;
}

#goal-title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    min-width: 0;
    --sn-white-space: "nowrap";
    overflow: hidden;
    text-overflow: clip;
}

#hud-days.wide {
    --sn-gap: "1px";
}

#hud-days.wide .t-i {
    width: 12px;
    letter-spacing: -1px;
}

.mtabs {
    position: relative;
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    height: 11px;
    flex-direction: row;
}

.mtab {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    height: 11px;
    --sn-line-height: "10px";
    padding-top: 1px;
    --sn-text-align: "center";
    background-color: var(--navyD);
    color: var(--ink3);
}

.mtab.on {
    background-color: var(--panel2);
    color: var(--ink);
    --sn-box-shadow: "inset 0 -2px 0 0 var(--violetL)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -2 0 0";
    --sn-bsc-0: var(--violetL);
}

.mtab-negro.on {
    background-color: #1A0A16;
    color: var(--magentaL);
    --sn-box-shadow: "inset 0 -2px 0 0 var(--magenta)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -2 0 0";
    --sn-bsc-0: var(--magenta);
}

.mtab .alert {
    position: absolute;
    right: -1px;
    top: -3px;
    background-color: var(--orange);
    color: var(--navyD);
    padding: 0 2px;
    --sn-line-height: "8px";
    height: 8px;
    --sn-animation: "pulse .9s steps(2) infinite";
}

.mtabs .t-kbd {
    position: absolute;
    right: -2px;
    top: 12px;
    display: none;
}

.mcard.black {
    background-color: #160A15;
    --sn-box-shadow: "inset 0 0 0 1px #3A1030";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: #3A1030;
}

.mcard.black.sel {
    background-color: #24101F;
}

.mcard.black .nm {
