}

#mkt-head .blk {
    --sn-font-style: "normal";
    color: var(--magentaL);
    margin-left: 3px;
}

#mkt-head .cap {
    --sn-font-style: "normal";
    color: var(--ink3);
    margin-left: 5px;
}

#live-pnl.capped {
    color: var(--yellow);
    --sn-animation: "pulse .8s steps(2) infinite";
}

.result-card .rc-cap {
    color: var(--yellow);
}

.sec-title {
    color: var(--yellow);
    margin: 5px 1px 3px;
    --sn-line-height: "10px";
}

.shop-row.key {
    --sn-box-shadow: "inset 2px 0 0 0 var(--cyan)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 2 0 0 0";
    --sn-bsc-0: var(--cyan);
}

.shop-row.key.locked {
    background-color: var(--navyD);
    color: var(--ink3);
}

.shop-row.key.locked .t {
    color: var(--ink3);
}

.shop-row.key.locked .ico {
    opacity: .35;
}

.offer {
    position: absolute;
    left: 50%;
    top: 50%;
    --sn-z-index: "5";
    width: 230px;
    --sn-transform: "translate(-50%, -50%)";
    padding: 0 0 6px;
    background-color: var(--navyD);
    color: var(--ink);
    --sn-text-align: "center";
    --sn-animation: "offerin .16s steps(3)";
    --sn-box-shadow: "0 0 0 1px var(--yellow), 0 0 0 2px var(--navyDD), 0 0 0 3px var(--magenta), 4px 5px 0 3px rgba(7, 5, 18, .6)";
    --sn-bs-n: "4";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--yellow);
    --sn-bs-1: "0 0 0 2";
    --sn-bsc-1: var(--navyDD);
    --sn-bs-2: "0 0 0 3";
    --sn-bsc-2: var(--magenta);
    --sn-bs-3: "4 5 0 3";
    --sn-bsc-3: rgba(7, 5, 18, .6);
}

.offer .of-head {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    height: 11px;
    padding: 1px 4px 0;
    background-color: var(--navyDD);
    color: var(--yellow);
    --sn-text-align: "left";
    letter-spacing: 1px;
    flex-direction: row;
}

.offer .of-head .t-span {
    margin-left: auto;
    color: var(--ink3);
    letter-spacing: 0;
}

.offer .of-ico {
    width: 8px;
    height: 8px;
    --sn-background-size: "8px 8px";
    --sn-image-rendering: "pixelated";
}

.offer .of-title {
    margin-top: 5px;
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--yellow);
}

.offer .of-line {
    margin: 3px 8px 0;
    --sn-line-height: "10px";
}

.offer .of-price {
    margin-top: 4px;
    display: flex;
    --sn-display: "flex";
    justify-content: center;
    --sn-align-items: "baseline";
    --sn-gap: "6px";
    flex-direction: row;
}

.offer .of-price s {
    color: var(--ink3);
}

.offer .of-price .t-b {
    --sn-font-family: "'SaldoNum', 'SaldoPixel', monospace";
    --sn-font-weight: "normal";
    font-size: 16px;
    --sn-line-height: "16px";
    color: var(--green);
}

.offer .of-price .t-em {
    --sn-font-style: "normal";
    color: var(--navyD);
    background-color: var(--coral);
    padding: 1px 2px 0;
}

.offer .of-later {
    margin-top: 3px;
    color: var(--ink2);
}

.offer .of-small {
    margin-top: 3px;
    font-size: 8px;
    color: var(--ink3);
    --sn-text-decoration: "underline";
}

.offer .of-small:hover {
    color: var(--ink2);
}

.offer .of-fine {
    margin: 2px 10px 0;
    padding: 2px 3px;
    --sn-line-height: "9px";
    color: var(--creamDD);
    background-color: var(--navyDD);
    --sn-text-align: "left";
}

.offer .of-row {
    margin-top: 6px;
    display: flex;
    --sn-display: "flex";
    justify-content: center;
    --sn-gap: "8px";
    flex-direction: row;
}

.offer .of-row .btn {
    padding: 3px 8px 2px;
}

.offer .of-short {
    margin: 4px 10px 0;
    color: var(--coral);
    --sn-line-height: "10px";
}

.win.offer-win {
    width: 0;
    height: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    --sn-box-shadow: "none";
    --sn-bs-n: "0";
    --sn-animation: "none";
}

.offer-win .win-body {
    position: relative;
    --sn-position: "static";
    overflow: visible;
    padding: 0;
}

.msg-toast.shop .t-b {
    color: var(--yellow);
}

.msg-toast.shop > .t-i {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

.up-tabs {
    display: flex;
    --sn-display: "flex";
    --sn-gap: "2px";
    margin: -2px 0 4px;
    flex-direction: row;
}

.up-tab {
    position: relative;
    height: 12px;
    --sn-line-height: "11px";
    padding: 1px 6px 0;
    background-color: var(--navyD);
    color: var(--ink3);
}

.up-tab.on {
    background-color: var(--panel2);
    color: var(--ink);
}

.up-tab.ac.on {
    color: var(--yellow);
}

.up-tab .badge {
    position: relative;
    --sn-position: "static";
    display: flex;
    --sn-display: "inline-block";
    margin-left: 3px;
    --sn-vertical-align: "1px";
}

.kw .t-i {
    --sn-font-style: "normal";
    display: flex;
    --sn-display: "inline-block";
}

.kw {
    --sn-white-space: "nowrap";
}

.kw-gold {
    --g1: #FFC22E;
    --g2: #FFF6C2;
    color: var(--g1);
    --sn-background: "linear-gradient(100deg, var(--g1) 0 42%, var(--g2) 47% 53%, var(--g1) 58% 100%)";
    --sn-background-size: "300% 100%";
    --sn--webkit-background-clip: "text";
    --sn-background-clip: "text";
    --sn--webkit-text-fill-color: "transparent";
    --sn-animation: "kwshine 2.4s steps(12) infinite";
}

.kw-7 .t-i {
    --sn--webkit-text-fill-color: "currentColor";
    --sn-animation: "kwrainbow 1.4s steps(7) infinite, kwbob .8s steps(2) infinite";
    --sn-animation-delay: "calc(var(--i) * -.2s), calc(var(--i) * -.13s)";
}

.kw-luck {
    color: var(--green);
}

.kw-luck .t-i {
    --sn-animation: "kwwave 1.1s steps(2) infinite";
    --sn-animation-delay: "calc(var(--i) * -.14s)";
}

.kw-up {
    color: var(--cyan);
}

.kw-up .t-i {
    --sn-animation: "kwglow 1.2s steps(2) infinite";
    --sn-animation-delay: "calc(var(--i) * -.1s)";
}

.kw-gift {
    color: var(--magentaL);
}

.kw-gift .t-i {
    --sn-animation: "kwgift 1.3s steps(2) infinite";
    --sn-animation-delay: "calc(var(--i) * -.16s)";
}

.kw-risk {
    color: var(--coral);
}

.kw-risk .t-i {
    --sn-animation: "kwshake 1.6s steps(1) infinite";
    --sn-animation-delay: "calc(var(--i) * -.07s)";
}

.kw-act {
    color: var(--yellow);
    --sn-box-shadow: "inset 0 -1px 0 0 var(--yellowD)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 -1 0 0";
    --sn-bsc-0: var(--yellowD);
    --sn-animation: "kwact 1s steps(2) infinite";
}

.paper .kw-up {
    color: var(--cyanD);
}

.nt .kw-up {
    color: var(--cyanD);
}

#hero-say .kw-up {
    color: var(--cyanD);
}

.paper .kw-gift {
    color: var(--magentaD);
}

.nt .kw-gift {
    color: var(--magentaD);
}

#hero-say .kw-gift {
