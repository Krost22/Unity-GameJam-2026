}

.dlg .txt.typing .kw-gold {
    --sn-animation: "none";
}

.dlg .txt.typing .kw-act {
    --sn-animation: "none";
}

.dlg .txt.typing .kw .t-i {
    --sn-animation: "none";
}

.cx-brand .cx {
    --sn-color: "inherit";
}

.cx-brand .cx-k {
