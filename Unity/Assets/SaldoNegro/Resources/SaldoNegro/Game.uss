    --sn-box-shadow: "inset 0 0 0 1px var(--violetD), 0 2px 0 0 rgba(0, 0, 0, .35)";
    --sn-bs-n: "2";
    --sn-bs-0: "inset 0 0 0 1";
    --sn-bsc-0: var(--violetD);
    --sn-bs-1: "0 2 0 0";
    --sn-bsc-1: rgba(0, 0, 0, .35);
}

.ac {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-height: 0;
    display: flex;
    --sn-display: "grid";
    flex-direction: column;
    --sn-grid-template-columns: "72px 1fr 96px";
    --sn-grid-template-rows: "30px 1fr 26px";
    --sn-gap: "3px";
}

.up-tab {
    --sn-white-space: "nowrap";
}

.ac-dt.sn-scrollbar {
    width: 3px;
}

.sh-dt.sn-scrollbar {
    width: 3px;
}

.ac-dt.sn-scrollbar-thumb {
    background-color: var(--violet);
}

.sh-dt.sn-scrollbar-thumb {
    background-color: var(--violet);
}

.ac-dt.sn-scrollbar-track {
    background-color: var(--navyDD);
}

.sh-dt.sn-scrollbar-track {
    background-color: var(--navyDD);
}

.ac-top {
    --sn-grid-column: "1 / 4";
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "6px";
    padding: 0 5px;
    flex-direction: row;
}

.ac-ava {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 24px;
    height: 24px;
    --sn-box-shadow: "0 0 0 1px var(--yellow)";
    --sn-bs-n: "1";
    --sn-bs-0: "0 0 0 1";
    --sn-bsc-0: var(--yellow);
}

.ac-ttl {
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    --sn-line-height: "10px";
    min-width: 0;
}

.ac-ttl .t-b {
    font-size: 16px;
    --sn-line-height: "16px";
    letter-spacing: -1px;
    color: var(--creamL);
    --sn-font-weight: "normal";
    --sn-text-shadow: "1px 0 0 currentColor";
    --sn-white-space: "nowrap";
}

.ac-ttl .t-span {
    color: var(--ink2);
    --sn-white-space: "nowrap";
}

.ac-inc {
    margin-left: auto;
    display: flex;
    --sn-display: "flex";
    flex-direction: column;
    align-items: flex-end;
    --sn-line-height: "10px";
    color: var(--green);
    --sn-white-space: "nowrap";
}

.ac-inc .t-span {
    color: var(--ink2);
}

.ac-cash {
    display: flex;
    --sn-display: "flex";
    align-items: center;
    --sn-gap: "3px";
    padding: 2px 5px;
    --sn-white-space: "nowrap";
    background-color: var(--navyDD);
    --sn-box-shadow: "inset 0 0 0 1px var(--violetL)";
    --sn-bs-n: "1";
    --sn-bs-0: "inset 0 0 0 1";
